# =============================================================================
# Billing Service — tariffs, invoicing
# =============================================================================
# Loaded after the workspace-root `.env`. DATABASE_URL, JWKS_URL, CERBOS_URL
# inherit from root.
# =============================================================================

BILLING_SVC_PORT=3003

# --- Optional ----------------------------------------------------------------
# BILLING_USE_MOCK_DATA=false
# Desk discounts / price overrides on POST /charges (visit registration).
# Defaults on when NODE_ENV≠production; set false to disable in dev.
# BILLING_ALLOW_DESK_OVERRIDES=false
# Mock-mode fallback tenant when no header (safe placeholder, not live bootstrap UUID):
# BILLING_DEV_TENANT_ID=00000000-0000-0000-0000-000000000007
