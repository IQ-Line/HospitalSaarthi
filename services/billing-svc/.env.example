# =============================================================================
# Billing Service — tariffs, invoicing
# =============================================================================
# Loaded after the workspace-root `.env`. DATABASE_URL, CERBOS_URL, JWT_* inherit from root.
# =============================================================================

BILLING_SVC_PORT=3003

# --- Optional ----------------------------------------------------------------
# Use the in-memory mock data instead of hitting the database (Phase 0 toggle).
# BILLING_USE_MOCK_DATA=false

# Default tenant UUID used by dev/Swagger when no tenant header is supplied.
# BILLING_DEV_TENANT_ID=
