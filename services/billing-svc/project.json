{
  "name": "billing-svc",
  "projectType": "application",
  "tags": ["type:service", "scope:billing", "language:typescript", "deploy:aks"],
  "targets": {
    "typecheck": {
      "command": "tsc -p tsconfig.json --noEmit",
      "options": {
        "cwd": "services/billing-svc"
      }
    },
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsup --config tsup.config.ts",
        "cwd": "services/billing-svc"
      },
      "outputs": ["{projectRoot}/dist"],
      "cache": true
    },
    "serve": {
      "command": "tsx watch --include '../../modules/billing/src' src/main.ts",
      "options": {
        "cwd": "services/billing-svc",
        "envFile": "{workspaceRoot}/.env"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "vitest run",
        "cwd": "services/billing-svc"
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint",
      "options": {
        "lintFilePatterns": [
          "services/billing-svc/src/**/*.ts",
          "services/billing-svc/test/**/*.ts"
        ]
      }
    }
  }
}
