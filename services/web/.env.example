# =============================================================================
# Web — React + Vite frontend
# =============================================================================
# Vite has its own env-file flow: only `VITE_*` keys are exposed to the
# browser bundle (see https://vitejs.dev/guide/env-and-mode). Non-VITE keys
# in this file are ignored by Vite at build time.
# =============================================================================

# Points at the BFF (NOT the Python/Node service ports) so the browser gets
# CORS + auth headers. Do not point at :8010 directly.
VITE_API_BASE_URL=http://localhost:3000

# Cerbos browser client (HTTP admin API on :3592; Node PDP gRPC is :3593).
VITE_CERBOS_URL=http://localhost:3592

# --- Optional ----------------------------------------------------------------
# Default tenant UUID for dev login flow.
# VITE_DEFAULT_IQ_TENANT_ID=

# Talk directly to registration-svc (bypass BFF). Dev default is :3006 when unset.
# VITE_REGISTRATION_SERVICE_ORIGIN=http://localhost:3006
