# Copy to `.env` in this directory. Do not commit real secrets.
# The service loads ONLY this file (see `src/load-env.ts`).

# Required — Azure / shared Postgres (`abdm_adapter` schema)
# Use postgresql:// (or postgresql+psycopg:// — dialect suffix is stripped).
# Azure: sslmode=require is added automatically if the host is *.postgres.database.azure.com
ABDM_DATA_DATABASE_URL=postgresql://user:password@your-host.postgres.database.azure.com:6432/temp-abdm?sslmode=require

# NHA sandbox (canonical names; aliases clientId / clientSecret also work)
ABDM_SANDBOX_CLIENT_ID=your_sandbox_client_id
ABDM_SANDBOX_CLIENT_SECRET=your_sandbox_client_secret

# Optional — defaults match Milestone 1 Postman collection
# ABDM_GATEWAY_BASE_URL=https://dev.abdm.gov.in
# ABDM_ABHA_API_BASE_URL=https://abhasbx.abdm.gov.in/abha/api
# ABDM_X_CM_ID=sbx
ABDM_ADAPTER_SVC_PORT=3007

# Tenant UUID for Swagger "Authorize" and curl (example only)
# ABDM_DEV_TENANT_ID=00000000-0000-4000-8000-0000000000aa

NODE_ENV=development

# Migrate: pnpm --filter @hims/abdm-adapter-svc db:migrate
# Start:   npx nx run abdm-adapter-svc:serve
# Swagger: http://localhost:3007/docs  (full M1 spec from specs/openapi/abdm-adapter.v1.yaml)
