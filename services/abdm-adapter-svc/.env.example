# =============================================================================
# ABDM Adapter Service — environment template
# =============================================================================
# 1. Copy:  cp .env.example .env
# 2. Fill secrets and your mobile — never commit .env
# 3. Pick your task:  docs/guides/abdm-adapter-e2e-and-production.md (read first)
# 4. M1 enrolment:    docs/guides/abdm-adapter-m1-runbook.md
# 5. M2 map:          docs/guides/abdm-adapter-m2-simple-reference.md
# 6. M3 mock loop:    docs/guides/abdm-adapter-m3-developer-and-e2e.md
# 7. Production:      docs/guides/abdm-adapter-e2e-and-production.md §10
# =============================================================================

ABDM_ADAPTER_SVC_PORT=3007

# -----------------------------------------------------------------------------
# DATABASE (required — sandbox and production)
# -----------------------------------------------------------------------------
# DATABASE_URL=postgresql://user:pass@host:5432/db?sslmode=require
# Or alias:
# ABDM_DATA_DATABASE_URL=postgresql://...

# After first deploy or upgrade, apply migrations:
#   psql "$DATABASE_URL" -f modules/abdm-adapter/migrations/0000_abdm_adapter_schema.sql
#   psql "$DATABASE_URL" -f modules/abdm-adapter/migrations/0001_abdm_adapter_m2_schema.sql
#   psql "$DATABASE_URL" -f modules/abdm-adapter/migrations/0002_abdm_link_otps.sql
#   psql "$DATABASE_URL" -f modules/abdm-adapter/migrations/0003_abdm_adapter_m3_schema.sql

# -----------------------------------------------------------------------------
# SANDBOX — required for local E2E
# -----------------------------------------------------------------------------
ABDM_SANDBOX_CLIENT_ID=your_sandbox_client_id
ABDM_SANDBOX_CLIENT_SECRET=your_sandbox_client_secret

# Same UUID as Swagger/curl header x-tenant-id
ABDM_DEV_TENANT_ID=00000000-0000-4000-8000-0000000000aa

# Your facility HIP from NHA sandbox / HFR (example only)
ABDM_X_HIP_ID=IN3610001625

# Your facility HIU id (M3 data-requester role; one per HIP/HIU pair in HFR)
ABDM_X_HIU_ID=SBX_TEST_HIU_001

# Consent manager — sandbox only
ABDM_X_CM_ID=sbx

# Optional overrides (defaults shown)
# ABDM_GATEWAY_BASE_URL=https://dev.abdm.gov.in
# ABDM_ABHA_API_BASE_URL=https://abhasbx.abdm.gov.in/abha/api

# -----------------------------------------------------------------------------
# SANDBOX — dev helpers (do NOT use in production)
# -----------------------------------------------------------------------------
ABDM_M2_MOCK_PLATFORM=true
ABDM_MOCK_ABHA_ADDRESS=test.user@sbx

# Fake consent/HI callbacks via curl (avoids ABDM-1080 on synthetic consent ids)
# ABDM_DEV_INBOUND_SIMULATION=true

# User-initiated link OTP (E.164). Also pass phoneNo in initiated-link/start body.
ABDM_DEFAULT_SMS_PHONE=+91XXXXXXXXXX
ABDM_HIP_DISPLAY_NAME=Hospital Saarthi Test HIP

# -----------------------------------------------------------------------------
# M3 — mock harness (local full-loop; do NOT use in production)
# -----------------------------------------------------------------------------
# See docs/guides/abdm-adapter-m3-developer-and-e2e.md and
# docs/architecture/lld/abdm-adapter/10-m3-mock-harness-guide.md
#
# Skip outbound CM posts; drive callbacks with modules/abdm-adapter/scripts/m3/*.sh
ABDM_M3_MOCK_GATEWAY=true
# HIP push rewrites dataPushUrl to this service's HIU receiver (same process)
ABDM_M3_LOOPBACK_HIU=true
# Public base URL embedded in dataPushUrl (use ngrok URL when testing callbacks externally)
# ABDM_ADAPTER_PUBLIC_BASE_URL=http://localhost:3007
# Comma-separated hosts allowed for HIP→HIU push when loopback is off. Empty = any (dev only).
# ABDM_M3_DATA_PUSH_URL_ALLOWLIST=
# ABDM_M3_AWAITING_PUSH_HOURS=24
# ABDM_M3_CONSENT_REQUEST_EXPIRY_HOURS=72
# ABDM_M3_KEYPAIR_TTL_HOURS=24
# ABDM_M3_PUSH_TIMEOUT_MS=10000
# ABDM_M3_PUSH_TOTAL_TIMEOUT_MS=180000

# -----------------------------------------------------------------------------
# SANDBOX — live M3 E2E (real NHA + ngrok) — see docs/guides/abdm-adapter-e2e-and-production.md §0.1.1, §6A, §12
# -----------------------------------------------------------------------------
# ABDM_X_HIU_ID=IN3610001625
# ABDM_M3_MOCK_GATEWAY=false
# ABDM_M3_LOOPBACK_HIU=false
# ABDM_ADAPTER_PUBLIC_BASE_URL=https://YOUR-ID.ngrok-free.dev
# ABDM_DEV_INBOUND_SIMULATION=false
# ABDM_ALLOW_INSECURE_CALLBACKS=true

# -----------------------------------------------------------------------------
# SANDBOX — optional / other dev modes
# -----------------------------------------------------------------------------
# ABDM_TOKEN_ENCRYPTION_KEY=          # unset = plaintext x_token in dev only
# ABDM_LINK_TOKEN_ACQUIRE_TIMEOUT_MS=8000
# ABDM_FIDELIUS_USE_STUB=true         # legacy base64 stub — NOT real NHA crypto
# ABDM_DEV_INBOUND_SIMULATION=true    # curl-only: skip outbound NHA acks (NOT for live M3)
# ABDM_ALLOW_INSECURE_CALLBACKS=true  # skip gateway JWS verify (local dev only)
# ABDM_ALLOW_PLAINTEXT_TOKENS=true
# ABDM_GATEWAY_JWKS_URL=https://dev.abdm.gov.in/api/hiecm/gateway/v3/certs
# ABDM_HIP_TENANT_MAP={"IN3610001625":"00000000-0000-4000-8000-0000000000aa"}
# ABDM_CM_CONSENT_VERIFY_CERT_PEM=    # CM X.509 PEM (sandbox CM cert if testing real consent sig)
# ABDM_GATEWAY_JWT_ISSUER=            # optional — pin gateway JWS issuer
# ABDM_GATEWAY_JWT_AUDIENCE=          # optional — pin gateway JWS audience
# ABDM_SMS_PROVIDER=logging         # logging | noop | http | twilio
# ABDM_SMS_HTTP_URL=
# ABDM_SMS_HTTP_API_KEY=
# ABDM_SMS_TWILIO_ACCOUNT_SID=
# ABDM_SMS_TWILIO_AUTH_TOKEN=
# ABDM_SMS_TWILIO_FROM=
# ABDM_LINK_TOKEN_POLL_INTERVAL_MS=200
# ABDM_LINK_TOKEN_POLL_MAX_INTERVAL_MS=1600
# ABDM_MOCK_PATIENT_ID=00000000-0000-4000-8000-000000000001
# ABDM_GATEWAY_TIMEOUT_MS=30000
# ABDM_SESSION_TTL_HOURS=24
# EMPI_BASE_URL=http://localhost:3002
# RECORD_FOUNDATION_BASE_URL=http://localhost:3004

# -----------------------------------------------------------------------------
# PRODUCTION / STAGING — set all of these before live traffic
# -----------------------------------------------------------------------------
# NODE_ENV=production
# ENABLE_AUTH=true
# JWKS_URL=https://your-identity-host/.well-known/jwks.json

# NHA production endpoints
# ABDM_GATEWAY_BASE_URL=https://<production-gateway-host>
# ABDM_ABHA_API_BASE_URL=https://<production-abha-api-base>
# ABDM_X_CM_ID=<production-cm-id>          # NOT "sbx"
# ABDM_X_HIP_ID=<production-hip-from-hfr>
# ABDM_X_HIU_ID=<production-hiu-from-hfr>

# M3 — required for live consent + data exchange
# ABDM_M3_MOCK_GATEWAY=false
# ABDM_M3_LOOPBACK_HIU=false
# ABDM_M3_DATA_PUSH_URL_ALLOWLIST=hiu.example.com,other-hiu.example.com
# ABDM_ADAPTER_PUBLIC_BASE_URL=https://your-ingress.example.com

# Credentials (prefer secrets manager; names stay ABDM_SANDBOX_* in Phase 0)
# ABDM_SANDBOX_CLIENT_ID=
# ABDM_SANDBOX_CLIENT_SECRET=

# Security — required
# ABDM_TOKEN_ENCRYPTION_KEY=              # openssl rand -base64 32
# ABDM_GATEWAY_JWKS_URL=                    # production gateway JWKS
# ABDM_CM_CONSENT_VERIFY_CERT_PEM=          # CM signing cert PEM (multiline ok)
# ABDM_HIP_TENANT_MAP={"<HIP_ID>":"<tenant-uuid>",...}

# Must be false or unset (startup throws if true):
# ABDM_M2_MOCK_PLATFORM=false
# ABDM_ALLOW_INSECURE_CALLBACKS=            # unset — enables JWS + consent verify
# ABDM_FIDELIUS_USE_STUB=                   # unset — uses BC Weierstrass Fidelius
# ABDM_DEV_INBOUND_SIMULATION=              # unset

# Upstream (required in production)
# EMPI_BASE_URL=https://empi.internal
# RECORD_FOUNDATION_BASE_URL=https://record-foundation.internal

# User-initiated link OTP (required for real patients)
# ABDM_SMS_PROVIDER=twilio                  # or http
# ABDM_SMS_TWILIO_ACCOUNT_SID=
# ABDM_SMS_TWILIO_AUTH_TOKEN=
# ABDM_SMS_TWILIO_FROM=+91XXXXXXXXXX
# ABDM_DEFAULT_SMS_PHONE=                   # fallback if session has no phone

# Optional hardening
# ABDM_GATEWAY_JWT_ISSUER=
# ABDM_GATEWAY_JWT_AUDIENCE=

# -----------------------------------------------------------------------------
# Commands
# -----------------------------------------------------------------------------
# npx nx run abdm-adapter-svc:db-migrate
# npx nx run abdm-adapter-svc:serve
# curl http://localhost:3007/healthz
# http://localhost:3007/docs
#
# M3 mock end-to-end (after migrate + serve with ABDM_M3_* above):
#   bash modules/abdm-adapter/scripts/m3/full-loop.sh
