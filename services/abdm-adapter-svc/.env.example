# =============================================================================
# ABDM Adapter Service — environment template
# =============================================================================
# 1. Copy:  cp .env.example .env
# 2. Fill secrets and your mobile — never commit .env
# 3. Easy guide:  docs/guides/abdm-adapter-m2-simple-reference.md
# 4. Step-by-step: docs/guides/abdm-adapter-m2-hands-on-walkthrough.md
# =============================================================================

ABDM_ADAPTER_SVC_PORT=3007

# -----------------------------------------------------------------------------
# SANDBOX — required for local E2E
# -----------------------------------------------------------------------------
ABDM_SANDBOX_CLIENT_ID=your_sandbox_client_id
ABDM_SANDBOX_CLIENT_SECRET=your_sandbox_client_secret

# Same UUID as Swagger/curl header x-tenant-id
ABDM_DEV_TENANT_ID=00000000-0000-4000-8000-0000000000aa

# Your facility HIP from NHA sandbox / HFR (example only)
ABDM_X_HIP_ID=IN3610001625

# Consent manager — sandbox only
ABDM_X_CM_ID=sbx

# Optional overrides (defaults shown)
# ABDM_GATEWAY_BASE_URL=https://dev.abdm.gov.in
# ABDM_ABHA_API_BASE_URL=https://abhasbx.abdm.gov.in/abha/api

# -----------------------------------------------------------------------------
# SANDBOX — dev helpers (do NOT use in production)
# -----------------------------------------------------------------------------
# Mock EMPI + Record Foundation (user-initiated link, HI push bundle)
ABDM_M2_MOCK_PLATFORM=true

# Patient ABHA used in Postman generate-token + Swagger link
ABDM_MOCK_ABHA_ADDRESS=test.user@sbx

# When simulating consent/HI with curl to ngrok (avoids ABDM-1080 on fake consent ids)
# ABDM_DEV_INBOUND_SIMULATION=true

# SMS after HIP link (E.164). Also pass phoneNo in initiated-link/start body.
ABDM_DEFAULT_SMS_PHONE=+91XXXXXXXXXX
ABDM_HIP_DISPLAY_NAME=Hospital Saarthi Test HIP

# -----------------------------------------------------------------------------
# SANDBOX — optional
# -----------------------------------------------------------------------------
# ABDM_DATA_DATABASE_URL=postgresql://user:pass@host:5432/db?sslmode=require
# ABDM_TOKEN_ENCRYPTION_KEY=   # unset = plaintext link tokens in dev only
# ABDM_GATEWAY_TIMEOUT_MS=30000
# ABDM_SESSION_TTL_HOURS=24

# Real EMPI + Record Foundation (then set ABDM_M2_MOCK_PLATFORM=false)
# EMPI_BASE_URL=http://localhost:3002
# RECORD_FOUNDATION_BASE_URL=http://localhost:3004

# -----------------------------------------------------------------------------
# PRODUCTION / STAGING — uncomment and set before live traffic
# -----------------------------------------------------------------------------
# NODE_ENV=production
# ENABLE_AUTH=true
# JWKS_URL=https://your-identity-host/.well-known/jwks.json
# ABDM_TOKEN_ENCRYPTION_KEY=     # openssl rand -base64 32
# ABDM_M2_MOCK_PLATFORM=false
# ABDM_DEV_INBOUND_SIMULATION=   # must be false or unset
# ABDM_GATEWAY_BASE_URL=         # production NHA gateway
# ABDM_ABHA_API_BASE_URL=        # production ABHA API
# ABDM_X_CM_ID=                  # not "sbx"
# ABDM_X_HIP_ID=                 # production HIP from HFR
# ABDM_SANDBOX_CLIENT_ID=        # use production client id in secrets manager
# ABDM_SANDBOX_CLIENT_SECRET=    # use production secret in secrets manager
# EMPI_BASE_URL=
# RECORD_FOUNDATION_BASE_URL=

# -----------------------------------------------------------------------------
# Commands
# -----------------------------------------------------------------------------
# npx nx run abdm-adapter-svc:db-migrate
# npx nx run abdm-adapter-svc:serve
# curl http://localhost:3007/healthz
# http://localhost:3007/docs
