# =============================================================================
# ABDM Adapter Service — NHA gateway + M1 ABHA enrolment
# =============================================================================
# Loaded after the workspace-root `.env`. Only keys that ONLY this service needs.
# Nx `envFile: "{workspaceRoot}/.env"` supplies cross-cutting vars (DATABASE_URL,
# JWT_*, CERBOS_URL, …). This file layers service-specific overrides on top.
# =============================================================================

ABDM_ADAPTER_SVC_PORT=3007

# --- NHA sandbox -------------------------------------------------------------
ABDM_SANDBOX_CLIENT_ID=your_sandbox_client_id
ABDM_SANDBOX_CLIENT_SECRET=your_sandbox_client_secret

# Optional — defaults match Milestone 1 Postman collection
# ABDM_GATEWAY_BASE_URL=https://dev.abdm.gov.in
# ABDM_ABHA_API_BASE_URL=https://abhasbx.abdm.gov.in/abha/api
# ABDM_X_CM_ID=sbx
# ABDM_DEV_TENANT_ID=00000000-0000-4000-8000-0000000000aa

# Dedicated DB override (when root DATABASE_URL is local Citus and this service
# should use a separate Postgres). Runtime and migrate both prefer this over DATABASE_URL.
# ABDM_DATA_DATABASE_URL=postgresql://user:pass@host:6432/temp-abdm?sslmode=require

# Required in staging/production — JWT validation on /api/abdm/v1/*
# ENABLE_AUTH=true

# Outbound NHA HTTP timeout (ms). Default 30000.
# ABDM_GATEWAY_TIMEOUT_MS=30000

# Platform session row TTL in context.expiresAt (hours). Default 24.
# ABDM_SESSION_TTL_HOURS=24

# Required in staging/production — 32-byte key as base64 (openssl rand -base64 32)
# ABDM_TOKEN_ENCRYPTION_KEY=

# OTP abuse guard (per tenant, in-process; use Redis when horizontally scaled)
# ABDM_OTP_RATE_LIMIT_MAX=10
# ABDM_OTP_RATE_LIMIT_WINDOW_SEC=3600

# Migrate: npx nx run abdm-adapter-svc:db-migrate  (also in `make db-migrate`)
# Start:   npx nx run abdm-adapter-svc:serve
# Swagger: http://localhost:3007/docs
