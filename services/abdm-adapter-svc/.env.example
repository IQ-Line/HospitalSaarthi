# ABDM adapter uses the repo-root `.env` only (see `src/workspace-env.ts`).
# Copy the root template and add sandbox credentials there:
#
#   cp .env.example .env          # at repo root
#   # In root .env set:
#   #   DATABASE_URL=postgresql://hims:hims@localhost:5433/hims_dev
#   #   ABDM_SANDBOX_CLIENT_ID=...
#   #   ABDM_SANDBOX_CLIENT_SECRET=...
#   #   ABDM_ADAPTER_SVC_PORT=3007
#
# Migrate (also runs via `make setup` / `make db-migrate`):
#   npx nx run abdm-adapter-svc:db-migrate
#
# Start:
#   npx nx run abdm-adapter-svc:serve
#
# Swagger: http://localhost:3007/docs
