{
  "name": "pharmacy-svc",
  "projectType": "application",
  "tags": ["type:service", "scope:pharmacy", "language:typescript", "deploy:aks"],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsup --config tsup.config.ts",
        "cwd": "services/pharmacy-svc"
      },
      "outputs": ["{projectRoot}/dist"],
      "cache": true
    },
    "serve": {
      "command": "tsx watch --include '../../modules/pharmacy/src' src/main.ts",
      "options": {
        "cwd": "services/pharmacy-svc",
        "envFile": "{workspaceRoot}/.env"
      },
      "dependsOn": ["pharmacy:db-migrate"]
    }
  }
}
