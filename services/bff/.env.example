# =============================================================================
# BFF — Backend-for-frontend gateway
# =============================================================================
# Loaded after the workspace-root `.env`. Only put keys here that ONLY the BFF
# needs — its port and the upstream service URLs it proxies to.
# =============================================================================

BFF_PORT=3000

# --- Upstream service URLs (BFF proxies these prefixes) ----------------------
USER_MANAGEMENT_URL=http://localhost:3005
CONFIGURATOR_URL=http://localhost:3001
EMPI_URL=http://localhost:3002
MASTER_DATA_URL=http://localhost:8010
REGISTRATION_URL=http://localhost:3006
OPD_URL=http://localhost:8020
PHARMACY_URL=http://localhost:3004
ANALYTICS_URL=http://localhost:3008
INTEGRATION_HUB_URL=http://localhost:3007
VISITS_SERVICE_URL=http://localhost:8020

# --- Optional toggles --------------------------------------------------------
# VISITS_STUB=true        # return stub 201 for Create Visit without a real upstream
# CORS_ORIGINS=https://app.example.com,https://staging.example.com   # production only
