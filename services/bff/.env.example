# =============================================================================
# BFF — Backend-for-frontend gateway
# =============================================================================
# Loaded after the workspace-root `.env`. Only put keys here that ONLY the BFF
# needs — its port and the upstream service URLs it proxies to.
# =============================================================================

BFF_PORT=3000

# --- Upstream service URLs (BFF proxies these prefixes) ----------------------
USER_MANAGEMENT_URL=http://localhost:3005
CONFIGURATOR_URL=http://localhost:3001
EMPI_URL=http://localhost:3002
MASTER_DATA_URL=http://localhost:8010
REGISTRATION_URL=http://localhost:3006
OPD_URL=http://localhost:8020
PHARMACY_URL=http://localhost:3004
INTEGRATION_HUB_URL=http://localhost:3007
VISITS_SERVICE_URL=http://localhost:8020

# --- Edge authentication -----------------------------------------------------
# When ENABLE_AUTH=true the BFF validates the bearer JWT (JWKS, RS256, issuer/
# audience) on every proxied request except the public prefixes (/api/auth,
# /api/v3 ABDM callbacks, /api/public), derives an authoritative x-user-id from the
# verified token, and asserts tenant scope: a request whose iq_tenant_id/x-tenant-id
# differs from the token's tenant is rejected 403 (platform super-admins excepted;
# an absent header is allowed — it selects master-data's global catalog). This is what
# stops a caller from reading another tenant's data on the OPD/master-data services,
# which trust the tenant header with no PDP of their own. ENABLE_AUTH +
# JWT_ISSUER/JWT_AUDIENCE/JWKS_URL come from the workspace-root .env (shared with every
# service). ENABLE_AUTH=true is REQUIRED in production (the BFF refuses to boot otherwise).
#
# Deploy note: JWKS_URL must equal JWT_ISSUER + /api/auth/.well-known/jwks.json, and
# JWT_ISSUER is the BFF's own public origin — so the BFF fetches JWKS through its own
# /api/auth proxy to user-management. Ensure the BFF can reach its own public origin
# from inside the container (cached after the first verify; fails closed -> 401s if not).

# --- Edge ban/revocation cutoff ----------------------------------------------
# Shared service-to-service secret (sent as `x-um-internal-key`) the BFF uses to call
# user-management's internal active-status endpoint per authenticated request (cached
# ~30s) — cutting off users deactivated or banned AFTER their token was issued, within
# the token's remaining TTL. MUST equal user-management's UM_INTERNAL_API_KEY (usually
# set once in the workspace-root .env). If unset, the cutoff is DISABLED (stale tokens
# remain valid until they expire); the BFF logs a warning. The check fails OPEN on any
# UM error, so a UM outage never blocks traffic.
UM_INTERNAL_API_KEY=

# --- Optional toggles --------------------------------------------------------
# VISITS_STUB=true        # return stub 201 for Create Visit without a real upstream
# CORS_ORIGINS=https://app.example.com,https://staging.example.com   # production only
