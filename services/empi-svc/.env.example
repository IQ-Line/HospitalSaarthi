# =============================================================================
# EMPI Service — Enterprise Master Patient Index
# =============================================================================
# Loaded after the workspace-root `.env`. DATABASE_URL, JWKS_URL, CERBOS_URL,
# CONFIGURATOR_URL, MASTER_DATA_URL inherit from root.
#
# The full PEP stack (identity + principal enrichment + Cerbos authz) is ALWAYS
# on — there is no opt-out. CERBOS_URL and DATABASE_URL are required at boot.
# =============================================================================

EMPI_SVC_PORT=3002

# --- Optional ----------------------------------------------------------------
# Dev-only tenant used when Swagger/curl omit the iq_tenant_id / x-tenant-id
# header (ignored when NODE_ENV=production).
# EMPI_DEV_TENANT_ID=00000000-0000-0000-0000-000000000007

# Fallback numeric code for the platform tenant (used when tenant lookup misses).
# EMPI_FALLBACK_TENANT_NUMERIC_CODE=001
