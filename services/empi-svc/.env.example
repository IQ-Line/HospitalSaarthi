# =============================================================================
# EMPI Service — Enterprise Master Patient Index
# =============================================================================
# Loaded after workspace-root `.env`. DATABASE_URL inherits from root (hims_dev).
# =============================================================================

EMPI_SVC_PORT=3002

# JWT validation: JWT_ISSUER / JWKS_URL / JWT_AUDIENCE — workspace root `.env.example` only.
# ENABLE_AUTH=true is set in root `.env.example` for demo-ready local stacks.
ENABLE_AUTH=true

# EMPI_FALLBACK_TENANT_NUMERIC_CODE=00001
