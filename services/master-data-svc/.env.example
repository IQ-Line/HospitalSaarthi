# Reference copy for Master Data service vars. Prefer the monorepo root `.env`.
# The Master Data MODULE owns its own MASTER_DATA_* config and the platform auth
# env (JWKS/issuer/audience/Cerbos/UM) — see modules/master-data/.env.example and
# the workspace-root .env. This wrapper adds only the deployment listen port.
MASTER_DATA_SVC_PORT=8010
# DB URL: the shared root DATABASE_URL is used by default (single hims_dev DB,
# ADR-0013). MASTER_DATA_DATABASE_URL is an OPTIONAL override.
# MASTER_DATA_DATABASE_URL=postgresql+psycopg://hims:hims@localhost:5433/hims_dev
