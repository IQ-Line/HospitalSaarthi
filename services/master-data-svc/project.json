{
  "name": "master-data-svc",
  "projectType": "application",
  "tags": ["type:service", "scope:master-data", "language:python", "deploy:aks"],
  "namedInputs": {
    "default": ["{projectRoot}/**/*"],
    "production": [
      "default",
      "!{projectRoot}/tests/**/*",
      "!{projectRoot}/.env*",
      "!{projectRoot}/README.md"
    ]
  },
  "targets": {
    "setup": {
      "command": "uv sync",
      "options": {
        "cwd": "services/master-data-svc"
      },
      "inputs": ["default", "{workspaceRoot}/modules/master-data/**/*"],
      "cache": true,
      "outputs": ["{projectRoot}/.venv"]
    },
    "serve": {
      "command": "uv run uvicorn master_data_svc.main:app --host 0.0.0.0 --port 8010 --reload --reload-dir src --reload-dir ../../modules/master-data/app",
      "options": {
        "cwd": "services/master-data-svc"
      },
      "dependsOn": ["master-data:db-migrate", "setup"]
    },
    "lint": {
      "command": "uv run ruff check .",
      "options": {
        "cwd": "services/master-data-svc"
      },
      "dependsOn": ["setup"],
      "inputs": ["default", "{projectRoot}/pyproject.toml"],
      "cache": true
    }
  }
}
