# =============================================================================
# Inventory Service — stores, items, GRN, stock, indents, transfers
# =============================================================================
# Loaded after the workspace-root `.env`. The auth/PEP stack (identity + Cerbos +
# principal enrichment) mirrors billing/registration; these inherit from root `.env`:
#   DATABASE_URL        — inventory schema (also the UM tables the PEP enricher reads)
#   JWKS_URL / JWT_ISSUER / JWT_AUDIENCE — bearer verification (identityPlugin)
#   CERBOS_URL          — PDP; required and now actually consumed (authz is enforced)
#   CONFIGURATOR_URL    — tenant module entitlements (principal enrichment)
#   MASTER_DATA_URL     — module catalog + store-type reads
# The request tenant is derived from the verified principal, not a client header —
# there is no dev-tenant override env for this service.
# =============================================================================

INVENTORY_SVC_PORT=3008

# --- Optional ----------------------------------------------------------------
# Set true in k8s when migrations run via CI/Makefile instead of on pod boot.
# INVENTORY_SKIP_MIGRATE=true
