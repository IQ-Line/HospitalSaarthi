{
  "name": "inventory-svc",
  "projectType": "application",
  "tags": ["type:service", "scope:inventory", "language:typescript", "deploy:aks"],
  "targets": {
    "typecheck": {
      "command": "tsc -p tsconfig.json --noEmit",
      "options": {
        "cwd": "services/inventory-svc"
      }
    },
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsup --config tsup.config.ts",
        "cwd": "services/inventory-svc"
      },
      "outputs": ["{projectRoot}/dist"],
      "cache": true
    },
    "serve": {
      "command": "tsx watch --include '../../modules/inventory/src' src/main.ts",
      "options": {
        "cwd": "services/inventory-svc",
        "envFile": "{workspaceRoot}/.env"
      },
      "dependsOn": ["inventory:db-migrate"]
    },
    "lint": {
      "executor": "@nx/eslint:lint",
      "options": {
        "lintFilePatterns": ["services/inventory-svc/src/**/*.ts"]
      }
    }
  }
}
