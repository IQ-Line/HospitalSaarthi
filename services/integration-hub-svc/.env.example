# =============================================================================
# Integration Hub Service — environment template
# =============================================================================
# Tenant credentials (HIP, client_id, client_secret) belong in Configurator
# (pnpm seed-abdm-profile), not here.
#
# Local dev env precedence (highest wins):
#   1. This file — service-specific overrides
#   2. Workspace-root `.env`
#      (CONFIGURATOR_URL, INTEGRATION_HUB_SVC_PORT, DATABASE_URL, …)
#
#   Run: npx nx run integration-hub-svc:db-migrate
#        npx nx run integration-hub-svc:serve
#
# AKS / CI deployment:
#   - Inject DATABASE_URL (or INTEGRATION_HUB_DATABASE_URL) via ConfigMap/Secret.
#   - No physical .env file is required; Nx targets read process env only.
#   - Run only: npx nx run integration-hub-svc:db-migrate
#   - Do not chain pnpm seed (dev-only user-management bootstrap).
# =============================================================================

INTEGRATION_HUB_SVC_PORT=3007

# Legacy aliases still accepted (see normalizeIntegrationHubEnvAliases in load-env.ts)
# ABDM_ADAPTER_SVC_PORT=3007

# -----------------------------------------------------------------------------
# DATABASE (required)
# -----------------------------------------------------------------------------
# DATABASE_URL=postgresql://user:pass@host:5432/hims_dev
# Or: INTEGRATION_HUB_DATABASE_URL=...

# -----------------------------------------------------------------------------
# CONFIGURATOR (required for per-tenant profiles)
# -----------------------------------------------------------------------------
CONFIGURATOR_URL=http://localhost:3001
# Required for callback HIP → tenant lookup:
# CONFIGURATOR_INTERNAL_API_KEY=

# -----------------------------------------------------------------------------
# CALLBACK FALLBACK (dev only — blocked in production/staging)
# -----------------------------------------------------------------------------
ABDM_DEV_TENANT_ID=1e8b5a2b-c4a2-4405-baad-c39b515a3426

# -----------------------------------------------------------------------------
# GATEWAY (deployment-level)
# -----------------------------------------------------------------------------
# INTEGRATION_HUB_ABDM_GATEWAY_BASE_URL=https://dev.abdm.gov.in
# INTEGRATION_HUB_ABDM_ABHA_API_BASE_URL=https://abhasbx.abdm.gov.in/abha/api
# INTEGRATION_HUB_TOKEN_ENCRYPTION_KEY=

# -----------------------------------------------------------------------------
# PLATFORM INTEGRATIONS
# -----------------------------------------------------------------------------
# EMPI_BASE_URL=
# RECORD_FOUNDATION_BASE_URL=

# -----------------------------------------------------------------------------
# AUTH (staging+)
# -----------------------------------------------------------------------------
# ENABLE_AUTH=false
# JWKS_URL=http://localhost:3000/.well-known/jwks.json

# -----------------------------------------------------------------------------
# M3 DEV
# -----------------------------------------------------------------------------
# INTEGRATION_HUB_ABDM_M3_MOCK_GATEWAY=true
# INTEGRATION_HUB_ABDM_M3_LOOPBACK_HIU=true
# INTEGRATION_HUB_PUBLIC_BASE_URL=http://localhost:3007
