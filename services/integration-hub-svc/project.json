{
  "name": "integration-hub-svc",
  "projectType": "application",
  "tags": ["type:service", "scope:integration-hub", "language:typescript", "deploy:aks"],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsup --config tsup.config.ts",
        "cwd": "services/integration-hub-svc"
      },
      "outputs": ["{projectRoot}/dist"],
      "cache": true
    },
    "serve": {
      "command": "tsx watch src/main.ts",
      "dependsOn": [
        "integration-hub:db-migrate",
        "ts-sdk-fhir:build",
        "ts-sdk-abha:build"
      ],
      "options": {
        "cwd": "services/integration-hub-svc",
        "envFile": "{workspaceRoot}/.env"
      }
    },
    "db:migrate": {
      "command": "tsx ../../modules/integration-hub/scripts/apply-migration.ts",
      "options": {
        "cwd": "services/integration-hub-svc",
        "envFile": "{workspaceRoot}/.env"
      }
    },
    "db-migrate": {
      "command": "tsx ../../modules/integration-hub/scripts/apply-migration.ts",
      "options": {
        "cwd": "services/integration-hub-svc",
        "envFile": "{workspaceRoot}/.env"
      }
    }
  }
}
