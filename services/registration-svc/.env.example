# =============================================================================
# Registration Service — patient registration / intake
# =============================================================================
# Loaded after the workspace-root `.env`. DATABASE_URL, CERBOS_URL, JWT_* inherit from root.
# inherit from root.
# =============================================================================

REGISTRATION_SVC_PORT=3006

# --- Direct EMPI call (registration -> EMPI is a synchronous HTTP hop) -------
EMPI_URL=http://localhost:3002

# --- Optional ----------------------------------------------------------------
# Enable JWT validation. Off by default in dev; REQUIRED in staging/production
# (service throws at boot in production if unset).
# ENABLE_AUTH=true

# Service-specific CORS origins (separate from BFF CORS).
# REGISTRATION_CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# Skip auto-DDL on boot (production deploys use explicit migrate).
# REGISTRATION_SKIP_MIGRATE=true
