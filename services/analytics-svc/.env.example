# =============================================================================
# Analytics Service — reporting and operational analytics
# =============================================================================
# Loaded after the workspace-root `.env`. DATABASE_URL, JWKS_URL, CERBOS_URL
# inherit from root.
# =============================================================================

ANALYTICS_SVC_PORT=3008

# --- Optional ----------------------------------------------------------------
# Enable JWT validation. Off by default in dev for fast iteration; REQUIRED
# in staging/production (the service throws at boot in production if unset).
# ENABLE_AUTH=true

# Skip schema migration on boot (default: migrate when DATABASE_URL is set).
# ANALYTICS_SKIP_MIGRATE=true
