{
  "name": "opd-svc",
  "projectType": "application",
  "tags": [
    "type:service",
    "scope:opd",
    "language:python",
    "deploy:aks"
  ],
  "namedInputs": {
    "default": [
      "{projectRoot}/**/*"
    ],
    "production": [
      "default",
      "!{projectRoot}/tests/**/*",
      "!{projectRoot}/.env*",
      "!{projectRoot}/README.md"
    ]
  },
  "targets": {
    "setup": {
      "command": "uv sync",
      "options": {
        "cwd": "services/opd-svc"
      },
      "inputs": [
        "default",
        "{workspaceRoot}/modules/opd/**/*"
      ],
      "cache": true,
      "outputs": [
        "{projectRoot}/.venv"
      ]
    },
    "serve": {
      "command": "uv run uvicorn opd_svc.main:app --host 0.0.0.0 --port 8020 --reload --reload-dir src --reload-dir ../../modules/opd/src/opd",
      "options": {
        "cwd": "services/opd-svc"
      },
      "dependsOn": [
        "opd:db-migrate",
        "setup"
      ]
    },
    "lint": {
      "command": "uv run ruff check .",
      "options": {
        "cwd": "services/opd-svc"
      },
      "dependsOn": [
        "setup"
      ],
      "inputs": [
        "default",
        "{projectRoot}/pyproject.toml"
      ],
      "cache": true
    }
  }
}
