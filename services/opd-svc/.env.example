# Reference copy for OPD service vars. Prefer the monorepo root `.env`.
OPD_DATABASE_URL=postgresql+psycopg://hims:hims@localhost:5433/hims_dev
# Skip auto-migrate on boot (local `nx run opd-svc:serve` still runs opd:db-migrate first).
# OPD_SKIP_MIGRATE=true
OPD_LOG_LEVEL=INFO
OPD_API_PREFIX=/api/v1/opd
OPD_CORS_ORIGINS=http://localhost:4200,http://localhost:5173
OPD_SVC_PORT=8020
PHARMACY_URL=http://localhost:3004
# Must match pharmacy-svc when set (optional in local dev).
# PHARMACY_INTERNAL_API_KEY=change-me-in-production
# Fire-and-forget M2 orchestration after prescription finalize (create-rx end consultation).
OPD_ABDM_M2_ENABLED=true
OPD_INTEGRATION_HUB_BASE_URL=http://localhost:3007
OPD_RECORD_FOUNDATION_BASE_URL=http://localhost:3009
# OP consult report PDF for ABDM DocumentReference (same as registration-svc).
# PDF_PLATFORM_URL=http://localhost:8091
# AZURE_STORAGE_CONNECTION_STRING=...
USER_MANAGEMENT_URL=http://localhost:3005
# pdf-platform for clinical report HTML/PDF — set PDF_PLATFORM_URL in workspace root `.env` only (same as registration-svc).
OPD_MASTER_DATA_URL=http://localhost:8010
