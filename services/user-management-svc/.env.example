# =============================================================================
# User Management Service — better-auth + UM APIs
# =============================================================================
# Loaded after workspace-root `.env`. Required upstream URLs are documented
# in the root `.env.example` (CONFIGURATOR_URL, MASTER_DATA_URL, CERBOS_URL).
# =============================================================================

USER_MANAGEMENT_SVC_PORT=3005

# --- better-auth (must match root JWT_ISSUER / AUTH_BASE_URL) ----------------
AUTH_BASE_URL=http://localhost:3000
AUTH_TRUSTED_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175
BETTER_AUTH_SECRET=local-dev-secret-change-in-production-min-32-chars!!

# --- Database (required; do not use shared hims_dev for runtime) --------------
# Schema user_management on hims_dev — use root DATABASE_URL

# --- Bootstrap: off by default; use `make setup` / `pnpm seed:user-management-dev`
PLATFORM_DEV_BOOTSTRAP=false
USER_MGMT_DEV_BOOTSTRAP=false

# --- Test-only ---------------------------------------------------------------
# BETTER_AUTH_DISABLE_JWT_KEY_ENCRYPTION=true
