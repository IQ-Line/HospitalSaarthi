# =============================================================================
# User Management Service — better-auth + UM APIs
# =============================================================================
# Loaded after the workspace-root `.env`. Only put keys here that ONLY this
# service needs — primarily the better-auth secret and auth origin config.
# =============================================================================

USER_MANAGEMENT_SVC_PORT=3005

# --- better-auth -------------------------------------------------------------
# `AUTH_BASE_URL` must match `JWT_ISSUER` from root .env (better-auth `baseURL` + JWT `iss`).
AUTH_BASE_URL=http://localhost:3100
AUTH_TRUSTED_ORIGINS=http://localhost:5180,http://localhost:5181,http://localhost:5182
BETTER_AUTH_SECRET=local-dev-secret-change-in-production-min-32-chars!!

# --- Optional ----------------------------------------------------------------
# Override the root DATABASE_URL if this service uses a dedicated DB/role.
# Falls back to root DATABASE_URL when unset.
# USER_MGMT_DATABASE_URL=postgresql://...

# Test-only: disable JWT key encryption so tests can sign deterministically.
# BETTER_AUTH_DISABLE_JWT_KEY_ENCRYPTION=true

# Dev-only: run the development bootstrap (creates platform tenant + super-admin).
# Default is on when NODE_ENV != production; set to `false` to skip.
# USER_MGMT_DEV_BOOTSTRAP=true
