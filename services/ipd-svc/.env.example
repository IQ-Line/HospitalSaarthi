# =============================================================================
# IPD Service — admission intake
# =============================================================================

IPD_SVC_PORT=3008

# Default true: in-memory store, no DB/Cerbos — use Swagger at http://localhost:3008/docs
# IPD_USE_MOCK_DATA=true

# When IPD_USE_MOCK_DATA=false, DATABASE_URL from root .env is required.
# Run: npx nx run ipd:db-migrate
# IPD_SKIP_MIGRATE=true   # skip DDL on boot (migrations run via make db-migrate)

# Dev tenant when Swagger omits iq_tenant_id header:
# IPD_DEV_TENANT_ID=00000000-0000-0000-0000-000000000007
