# =============================================================================
# Configurator Service — tenants, organizations, module enablement
# =============================================================================
# Loaded after workspace-root `.env`. Uses DATABASE_URL (hims_dev) from root.
# =============================================================================

CONFIGURATOR_SVC_PORT=3001

# --- Database (schema `configurator` on hims_dev; set in root .env as DATABASE_URL)

# --- Bootstrap: off by default; use `make setup` seed -------------------------
PLATFORM_DEV_BOOTSTRAP=false
