# =============================================================================
# Configurator Service — tenants, organizations, module enablement
# =============================================================================
# Loaded after workspace-root `.env`. Uses CONFIGURATOR_DATABASE_URL from root.
# =============================================================================

CONFIGURATOR_SVC_PORT=3001

# --- Database (required; migrate and runtime both use CONFIGURATOR_DATABASE_URL)
# CONFIGURATOR_DATABASE_URL=postgresql://hims:hims@localhost:5433/hims-configurator

# --- Bootstrap: off by default; use `make setup` seed -------------------------
PLATFORM_DEV_BOOTSTRAP=false
