# MASTER_DATA_DATABASE_URL=postgresql+psycopg://superuser:5Ba45KeatYEeXfBAV3KHBqigO@iqline-dev-shared-pg.postgres.database.azure.com:6432/hims-v2?sslmode=require
# OPD_DATABASE_URL=postgresql+psycopg://superuser:5Ba45KeatYEeXfBAV3KHBqigO@iqline-dev-shared-pg.postgres.database.azure.com:6432/hims-v2?sslmode=require

# --- Cerbos PDP --------------------------------------------------------------
CERBOS_URL=grpc://localhost:3593

# --- Service host (internal URLs = http://${SERVICE_HOST}:<port>) -------------
SERVICE_HOST=localhost

# --- Service ports (each service has its own var — no shared PORT) ------------
BFF_PORT=3000
CONFIGURATOR_SVC_PORT=3001
EMPI_SVC_PORT=3002
BILLING_SVC_PORT=3003
FRONTDESK_SVC_PORT=3004
USER_MANAGEMENT_SVC_PORT=3005
ABDM_ADAPTER_SVC_PORT=3007
MASTER_DATA_SVC_PORT=8010
VISITS_SVC_PORT=8020
OPD_URL=http://localhost:8020
OPD_SVC_PORT=8020
WEB_DEV_PORT=5173

# --- Upstream services (User Management entitlement lookups) -----------------
CONFIGURATOR_URL=http://localhost:3001
MASTER_DATA_URL=http://localhost:8010

# --- Authentication (better-auth via BFF → user-management-svc) ---------------
BETTER_AUTH_SECRET=local-dev-secret-change-in-production-min-32-chars!!
AUTH_BASE_URL=http://localhost:3000
JWKS_URL=http://localhost:3000/api/auth/.well-known/jwks.json
JWT_ISSUER=http://localhost:3000
JWT_AUDIENCE=hims-platform

# --- Event Bus ----------------------------------------------------------------
EVENT_BUS_TYPE=in-process

# --- Observability (LGTM stack) -----------------------------------------------
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# --- Frontend (browser → Vite :5173 → proxy → BFF) --------------------------
VITE_API_BASE_URL=http://localhost:3000

# --- Auth CSRF ----------------------------------------------------------------
AUTH_TRUSTED_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175

# --- Docker infra (host ports from infra/docker/docker-compose.yml) -----------
# Postgres 5433, PgBouncer 6432, Cerbos 3593 — change compose if these clash

# --- General ------------------------------------------------------------------
NODE_ENV=development
LOG_LEVEL=debug
ENABLE_AUTH=true