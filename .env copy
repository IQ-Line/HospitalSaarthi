# =============================================================================
# HIMS Platform — Local Development Environment Variables
# =============================================================================
# Copy to .env:  cp .env.example .env
# DB: local Docker Postgres (clone of Azure ``hims-v2``). See .env.example for defaults.

# --- Database (local Docker — cloned from Azure hims-v2) ----------------------
DATABASE_URL=postgresql://hims:hims@localhost:5433/hims_dev
PGBOUNCER_URL=postgresql://hims:hims@localhost:6432/hims_dev
MASTER_DATA_DATABASE_URL=postgresql+psycopg://hims:hims@localhost:5433/hims_dev
OPD_DATABASE_URL=postgresql+psycopg://hims:hims@localhost:5433/hims_dev

# --- Database (Azure shared dev) — commented out -----------------------------
# Requires ?sslmode=require and your IP on the Azure Postgres firewall.
# DATABASE_URL=postgresql://superuser:5Ba45KeatYEeXfBAV3KHBqigO@iqline-dev-shared-pg.postgres.database.azure.com:6432/hims-v2?sslmode=require
