# =============================================================================
# HIMS Platform — Local Development Environment Variables
# =============================================================================
# Copy to .env:  cp .env.example .env
# All values below work with the default docker-compose setup.

# --- Database (Citus) --------------------------------------------------------
# docker-compose maps container 5432 to host 5433.
DATABASE_URL=postgresql://hims:hims@localhost:5433/hims_dev
# PGBOUNCER_URL=postgresql://hims:hims@localhost:6432/hims_dev

# --- Cerbos PDP --------------------------------------------------------------
CERBOS_URL=localhost:3593

# --- Authentication (User Management better-auth + JWT) -----------------------
# `AUTH_BASE_URL` must match `JWT_ISSUER` for this service (better-auth `baseURL` + JWT `iss`).
# `JWKS_URL` must match better-auth JWKS on this service (`basePath` + `/.well-known/jwks.json`).
AUTH_BASE_URL=http://localhost:3000
AUTH_TRUSTED_ORIGINS=http://localhost:5173
BETTER_AUTH_SECRET=local-dev-secret-change-in-production-min-32-chars!!
JWKS_URL=http://localhost:3000/api/auth/.well-known/jwks.json
JWT_ISSUER=http://localhost:3000
JWT_AUDIENCE=hims-platform

# --- Event Bus ----------------------------------------------------------------
EVENT_BUS_TYPE=in-process

# --- Observability (LGTM stack) -----------------------------------------------
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# --- Frontend -----------------------------------------------------------------
# BFF (not the Python/Node service port) so the browser gets CORS + auth headers; do not point at :8010.
VITE_API_BASE_URL=http://localhost:3000

# --- BFF (production CORS) ---------------------------------------------------
# When NODE_ENV=production, comma-separated exact browser origins allowed by the BFF.
# CORS_ORIGINS=https://app.example.com,https://staging.example.com

# --- General ------------------------------------------------------------------
NODE_ENV=development
LOG_LEVEL=debug
PORT=3000
