# =============================================================================
# HIMS Platform — Local Development Environment Variables
# =============================================================================
# Copy to .env:  cp .env.example .env
# All values below work with the default docker-compose setup.

# --- Database (Citus) --------------------------------------------------------
# docker-compose maps container 5432 to host 5433.
DATABASE_URL=postgresql://superuser:5Ba45KeatYEeXfBAV3KHBqigO@iqline-dev-shared-pg.postgres.database.azure.com:5432/hims-configurator?sslmode=require
# DATABASE_URL=postgresql://hims:hims@localhost:5433/hims_dev
# PGBOUNCER_URL=postgresql://hims:hims@localhost:6432/hims_dev

# --- Cerbos PDP --------------------------------------------------------------
CERBOS_URL=localhost:3593

# --- Authentication (better-auth) --------------------------------------------
BETTER_AUTH_SECRET=local-dev-secret-change-in-production
BETTER_AUTH_URL=http://localhost:3000
JWKS_URL=http://localhost:3001/.well-known/jwks.json

# --- Event Bus ----------------------------------------------------------------
EVENT_BUS_TYPE=in-process

# --- Observability (LGTM stack) -----------------------------------------------
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# --- Frontend -----------------------------------------------------------------
VITE_API_BASE_URL=http://localhost:3000

# --- General ------------------------------------------------------------------
NODE_ENV=development
LOG_LEVEL=debug
PORT=3000
