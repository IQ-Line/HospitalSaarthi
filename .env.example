# =============================================================================
# HIMS Platform — Workspace-Root Environment Variables
# =============================================================================
# Shared infrastructure and cross-cutting config for most services, BFF, and web.
#
# Most TypeScript services also ship `services/<svc>/.env.example` for ports and
# service-only keys. **abdm-adapter-svc is an exception:** it reads **only** this
# file (and `.env.local` here), not `services/abdm-adapter-svc/.env`.
#
# Quick start:
#   cp .env.example .env
#   make env-init                  # copies other services' .env.example files
#
# Per-developer overrides: `.env.local` at repo root (gitignored).
# Env precedence for abdm-adapter-svc: `.env` → `.env.local` → deprecated
# `services/abdm-adapter-svc/.env` → `services/abdm-adapter-svc/.env.local`
# =============================================================================

# --- Database (Citus, via docker-compose) ------------------------------------
# docker-compose maps container 5432 to host 5433 (avoids clash with native PG).
DATABASE_URL=postgresql://hims:hims@localhost:5433/hims_dev
PGBOUNCER_URL=postgresql://hims:hims@localhost:6432/hims_dev
# PGSSLMODE=require    # set when DATABASE_URL points at a managed PG that requires SSL

# --- Cerbos PDP (authorization decision point) -------------------------------
CERBOS_URL=localhost:3593

# --- JWT validation (every authenticated service trusts the same issuer) -----
# Issuer = user-management-svc's better-auth (running behind the BFF on :3000).
JWKS_URL=http://localhost:3000/api/auth/.well-known/jwks.json
JWT_ISSUER=http://localhost:3000
JWT_AUDIENCE=hims-platform

# --- Event bus ---------------------------------------------------------------
EVENT_BUS_TYPE=in-process

# --- Observability (LGTM stack — optional locally) ---------------------------
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# --- ABDM adapter (abdm-adapter-svc) -----------------------------------------
# Migration: if you had `services/abdm-adapter-svc/.env`, copy values here or
# into `.env.local`, then remove the service file. `make env-init` no longer
# creates `services/abdm-adapter-svc/.env`.
ABDM_ADAPTER_SVC_PORT=3007
# ABDM_SANDBOX_CLIENT_ID=your_sandbox_client_id
# ABDM_SANDBOX_CLIENT_SECRET=your_sandbox_client_secret
# ABDM_GATEWAY_BASE_URL=https://dev.abdm.gov.in
# ABDM_ABHA_API_BASE_URL=https://abhasbx.abdm.gov.in/abha/api
# ABDM_X_CM_ID=sbx
# ABDM_DEV_TENANT_ID=00000000-0000-4000-8000-0000000000aa
# Deprecated: dedicated ABDM Postgres when root DATABASE_URL is local docker.
# ABDM_DATA_DATABASE_URL=postgresql://user:pass@host:6432/temp-abdm?sslmode=require

# Required in staging/production — JWT on /api/abdm/v1/* (defaults off locally)
# ENABLE_AUTH=true
# JWKS_URL is shared above; override if ABDM should trust a different issuer.

# Outbound NHA HTTP timeout (ms). Default 30000.
# ABDM_GATEWAY_TIMEOUT_MS=30000

# Platform session row TTL in context.expiresAt (hours). Default 24.
# ABDM_SESSION_TTL_HOURS=24

# Required in staging/production — 32-byte key as base64 (openssl rand -base64 32)
# ABDM_TOKEN_ENCRYPTION_KEY=

# OTP abuse guard (per tenant, in-process; use Redis when horizontally scaled)
# ABDM_OTP_RATE_LIMIT_MAX=10
# ABDM_OTP_RATE_LIMIT_WINDOW_SEC=3600

# --- General -----------------------------------------------------------------
NODE_ENV=development
LOG_LEVEL=debug
# ENABLE_API_DOCS=true   # `true` = always expose Swagger UI; unset = expose unless production
