# =============================================================================
# HIMS Platform — Workspace-Root Environment Variables
# =============================================================================
# Cross-cutting infrastructure config consumed by EVERY process (services, BFF,
# web). Service-specific keys (ports, service secrets, per-service upstreams)
# live in `services/<svc>/.env.example` next to the code that reads them.
#
# Quick start:
#   cp .env.example .env          # this file
#   make env-init                  # copies every services/<svc>/.env.example -> .env
#
# Per-developer overrides (e.g. local port conflicts) go in `.env.local` here
# OR `services/<svc>/.env.local` — both are gitignored, never shared.
# Nx loads: services/<svc>/.env.local > services/<svc>/.env > .env.local > .env
# =============================================================================

# --- Database (Citus) --------------------------------------------------------
# docker-compose maps container 5432 to host 5433.
# Per-module databases (create once): infra/db/create-module-databases.sql
CONFIGURATOR_DATABASE_URL=postgresql://hims:hims@localhost:5433/hims-configurator
USER_MGMT_DATABASE_URL=postgresql://hims:hims@localhost:5433/hims-user-management
# Legacy monolith DB (optional fallback for tools not yet split):
DATABASE_URL=postgresql://hims:hims@localhost:5433/hims_dev
PGBOUNCER_URL=postgresql://hims:hims@localhost:6432/hims_dev
# PGSSLMODE=require    # set when DATABASE_URL points at a managed PG that requires SSL

# --- Cerbos PDP (authorization decision point) -------------------------------
CERBOS_URL=localhost:3593

# --- JWT validation (every authenticated service trusts the same issuer) -----
# Issuer = user-management-svc's better-auth (running behind the BFF on :3000).
JWKS_URL=http://localhost:3000/api/auth/.well-known/jwks.json
JWT_ISSUER=http://localhost:3000
JWT_AUDIENCE=hims-platform

# --- Event bus ---------------------------------------------------------------
EVENT_BUS_TYPE=in-process

# --- Observability (LGTM stack — optional locally) ---------------------------
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# --- Backend Fastify services (avoid clashing with root PORT=3000 / BFF) -------
# Each service listens on its own env; unset = defaults below.
# CONFIGURATOR_SVC_PORT=3001
# EMPI_SVC_PORT=3002
# BILLING_SVC_PORT=3003
# FRONTDESK_SVC_PORT=3004

# --- EMPI (BFF proxies /api/empi/v1/* here) ------------------------------------
EMPI_URL=http://localhost:3002

# --- Upstream services (User Management entitlement lookups) -----------------
# Used by user-management-svc for GET /capabilities/assignable (direct service URLs, not BFF).
# Requires configurator-svc on :3001 (included in `pnpm dev:web-stack`). Configurator dev bootstrap
# seeds org/tenant/tenant_modules in hims-configurator; UM bootstrap seeds users/roles in
# hims-user-management. master-data:serve on :8010 is needed only when resolving tenant module slugs.
CONFIGURATOR_URL=http://localhost:3001
MASTER_DATA_URL=http://localhost:8010

# --- Master Data (Python FastAPI, `nx run master-data:serve`, port 8010) -------
# Catalog DB (`public` + `tenant_master` schemas). SQLAlchemy uses the psycopg3 driver prefix.
MASTER_DATA_DATABASE_URL=postgresql+psycopg://hims:hims@localhost:5433/hims-master
# MASTER_DATA_LOG_LEVEL=INFO
# MASTER_DATA_API_PREFIX=/api/v1/master-data
# MASTER_DATA_CORS_ORIGINS=http://localhost:4200,http://localhost:5173

# --- Visits service (BFF proxies POST /api/v1/visits here) --------------------
VISITS_SERVICE_URL=http://localhost:8020
# Set on BFF process only: return stub 201 for Create Visit without a real service.
# VISITS_STUB=true

# --- Frontend -----------------------------------------------------------------
# BFF (not the Python/Node service port) so the browser gets CORS + auth headers; do not point at :8010.
VITE_API_BASE_URL=http://localhost:3000

# --- Fastify API docs (Swagger UI + OpenAPI JSON) -----------------------------
# `true` = always expose `/docs` (Swagger UI) and `/docs/json` (OpenAPI) even in production.
# `false` = never expose.
# unset = expose when NODE_ENV is not `production`.
# ENABLE_API_DOCS=true

# --- BFF (production CORS) ---------------------------------------------------
# When NODE_ENV=production, comma-separated exact browser origins allowed by the BFF.
# CORS_ORIGINS=https://app.example.com,https://staging.example.com

# --- General ------------------------------------------------------------------
# --- General -----------------------------------------------------------------
NODE_ENV=development
LOG_LEVEL=debug
# ENABLE_API_DOCS=true   # `true` = always expose Swagger UI; unset = expose unless production
