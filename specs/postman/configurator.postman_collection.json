  "item": [
    {
      "name": "Organizations",
      "item": [
        {
          "name": "List Organizations",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/organizations",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "organizations"
              ]
            }
          }
        },
        {
          "name": "Create Organization",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 201) {",
                  "  const json = pm.response.json();",
                  "  pm.collectionVariables.set('orgId', json.organization.id);",
                  "  pm.collectionVariables.set('tenantId', json.default_tenant.iq_tenant_id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"AIIMS Test Org\",\n  \"slug\": \"aiims-test-org\",\n  \"type\": \"hospital_chain\",\n  \"contact_email\": \"ops@aiims.test\",\n  \"contact_phone\": \"+91-9999999999\",\n  \"address\": \"Delhi\",\n  \"metadata\": {\n    \"source\": \"postman\"\n  }\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/organizations",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "organizations"
              ]
            }
          }
        },
        {
          "name": "Get Organization By ID",
          "request": {
            "method": "GET",
            "header": [],
