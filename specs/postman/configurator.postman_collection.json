              "raw": "{{baseUrl}}/organizations/{{orgId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "organizations",
                "{{orgId}}"
              ]
            }
          }
        },
        {
          "name": "Patch Organization",
          "request": {
            "method": "PATCH",
