              "raw": "{\n  \"status\": \"active\",\n  \"contact_phone\": \"+91-8888888888\",\n  \"metadata\": {\n    \"updatedBy\": \"postman\"\n  }\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/organizations/{{orgId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "organizations",
                "{{orgId}}"
              ]
            }
          }
        }
      ]
