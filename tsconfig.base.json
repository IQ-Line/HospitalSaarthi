{
  "compilerOptions": {
    "target": "ES2024",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "baseUrl": ".",
    "lib": ["ES2024"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "exactOptionalPropertyTypes": false,
    "paths": {
      "@hims/openapi-clients": ["packages/openapi-clients/src/index.ts"],
      "@hims/eslint-config": ["packages/eslint-config/index.js"],
      "@hims/configurator": ["modules/configurator/src/index.ts"],
      "@hims/empi": ["modules/empi/src/index.ts"],
      "@hims/master-data": ["modules/master-data/src/index.ts"]
    }
  },
  "exclude": ["node_modules", "dist"]
}
