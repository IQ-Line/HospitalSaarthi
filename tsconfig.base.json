{
  "compilerOptions": {
    "baseUrl": ".",
    "target": "ES2024",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2024"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "exactOptionalPropertyTypes": false,
    "paths": {
      "@hims/ts-sdk-api-key": ["./packages/ts-sdk-api-key/src/index.ts"],
      "@hims/ts-sdk-identity": ["./packages/ts-sdk-identity/src/index.ts"],
      "@hims/ts-sdk-authz": ["./packages/ts-sdk-authz/src/index.ts"],
      "@hims/ts-sdk-events": ["./packages/ts-sdk-events/src/index.ts"],
      "@hims/pdf-client": ["./packages/pdf-client/src/index.ts"],
      "@hims/registration-reports": ["./packages/registration-reports/src/index.ts"],
      "@hims/ts-sdk-db": ["./packages/ts-sdk-db/src/index.ts"],
      "@hims/ts-sdk-tenant": ["./packages/ts-sdk-tenant/src/index.ts"],
      "@hims/ts-sdk-openapi": ["./packages/ts-sdk-openapi/src/index.ts"],
      "@hims/ts-sdk-testing": ["./packages/ts-sdk-testing/src/index.ts"],
      "@hims/ts-sdk-fhir": ["./packages/ts-sdk-fhir/src/index.ts"],
      "@hims/ts-sdk-abha": ["./packages/ts-sdk-abha/src/index.ts"],
      "@hims/ts-sdk-sequence": ["./packages/ts-sdk-sequence/src/index.ts"],
      "@hims/openapi-clients": ["./packages/openapi-clients/src/index.ts"],
      "@hims/eslint-config": ["./packages/eslint-config/index.js"],
      "@hims/user-management": ["./modules/user-management/src/index.ts"],
      "@hims/configurator": ["./modules/configurator/src/index.ts"],
      "@hims/integration-hub": ["./modules/integration-hub/src/index.ts"],
      "@hims/empi": ["./modules/empi/src/index.ts"],
      "@hims/billing": ["./modules/billing/src/index.ts"],
      "@hims/registration": ["./modules/registration/src/index.ts"],
      "@hims/record-foundation": ["./modules/record-foundation/src/index.ts"],
      "@hims/pharmacy": ["./modules/pharmacy/src/index.ts"],
      "@hims/analytics": ["./modules/analytics/src/index.ts"],
      "@hims/master-data": ["./modules/master-data/src/index.ts"]
    }
  },
  "exclude": ["node_modules", "dist"]
}
