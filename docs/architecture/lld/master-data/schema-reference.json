{
  "$schema": "erd/v1",
  "schema": "master_data",
  "description": "Master Data \u2014 platform catalog (modules tree, permission definitions, role templates, picklists), Configurator-facing registry (config schemas, feature flags). Healthcare reference data is Post-launch. See 01-schema-design.md.",
  "citus": {
    "distribution_column": "iq_tenant_id",
    "reference_tables": [
      "modules",
      "permissions",
      "module_permissions",
      "system_roles",
      "picklist",
      "picklist_values",
      "module_config_schemas",
      "feature_flags"
    ],
    "notes": "All entities above are Citus reference tables (replicated). No distributed master_data MVP tables remain in this contract."
  },
  "entities": {
    "modules": {
      "description": "Deployable module registry plus admin/menu tree. Rows are platform-defined (migrations). parent_id forms a bounded hierarchy; name is the stable API/event key; slug is URL-safe and unique; category classifies modules for admin catalog (core|clinical|administrative|support), not authorization. Display labels, default routes, and \u2018always-on core\u2019 enforcement live in the shell / Configurator / conventions beyond this column.",
      "distribution": "reference",
      "columns": {
        "id": {
          "type": "UUID",
          "nullable": false,
          "default": "gen_random_uuid()"
        },
        "parent_id": {
          "type": "UUID",
          "nullable": true,
          "description": "Parent module for tree (NULL = root). FK \u2192 modules.id. ON DELETE RESTRICT recommended to avoid orphaning children."
        },
        "name": {
          "type": "TEXT",
          "nullable": false,
          "unique": true,
          "description": "Stable machine name (e.g. opd, user_management). Used in APIs, events, cross-module references."
        },
        "slug": {
          "type": "TEXT",
          "nullable": false,
          "unique": true,
          "description": "URL-safe unique key for SPA routes and external links."
        },
        "description": {
          "type": "TEXT",
          "nullable": true,
          "description": "Purpose summary."
        },
        "category": {
          "type": "TEXT",
          "nullable": false,
          "check": "category IN ('core', 'clinical', 'administrative', 'support')"
        },
        "version": {
          "type": "TEXT",
          "nullable": false,
          "default": "0.0.0",
          "description": "Deployed semver; updated by module migrations."
        },
        "level": {
          "type": "INT",
          "nullable": false,
          "default": "1",
          "check": "level >= 1 AND level <= 10",
          "description": "Tree depth for menus (max levels adjustable via migration if product needs it)."
        },
        "icon": {
          "type": "TEXT",
          "nullable": true,
          "description": "UI icon token (design system key)."
        },
        "is_active": {
          "type": "BOOLEAN",
          "nullable": false,
          "default": "true",
          "description": "Catalog visibility; inactive nodes hidden from default admin navigation."
        },
        "is_deleted": {
          "type": "BOOLEAN",
          "nullable": false,
          "default": "false",
          "description": "Soft-delete flag; rows kept for audit. APIs exclude deleted rows from list/detail by default; no hard DELETE for catalog lifecycle."
        },
        "created_at": {
          "type": "TIMESTAMPTZ",
          "nullable": false,
          "default": "now()"
        },
        "updated_at": {
          "type": "TIMESTAMPTZ",
          "nullable": false,
          "default": "now()"
        },
        "created_by": {
          "type": "UUID",
          "nullable": true,
          "description": "Actor user id when row is created via authenticated flows; nullable for migration-only seeds."
        },
        "updated_by": {
          "type": "UUID",
          "nullable": true,
          "description": "Last modifier user id; nullable when updates are deployment-driven."
        }
      },
      "primary_key": [
        "id"
      ],
      "indexes": [
        {
          "columns": [
            "is_deleted"
          ],
          "name": "idx_modules_is_deleted",
          "note": "Filter active catalog rows"
        },
        {
          "columns": [
            "name"
          ],
          "name": "modules_name_active_key",
          "unique": true,
          "partial_where": "NOT is_deleted",
          "note": "Unique machine name among active (non-deleted) rows"
        },
        {
          "columns": [
            "slug"
          ],
          "name": "modules_slug_active_key",
          "unique": true,
          "partial_where": "NOT is_deleted",
          "note": "Unique slug among active rows; soft-delete frees the slug"
        },
        {
          "columns": [
            "parent_id"
          ],
          "name": "idx_modules_parent",
          "note": "List children for tree build"
        },
        {
          "columns": [
            "category"
          ],
          "name": "idx_modules_category",
          "note": "Filter catalog by category in admin UI"
        }
      ]
    },
    "permissions": {
      "description": "Platform permission definitions (labels, slugs, actions). These are catalog rows \u2014 not user assignments. Effective authorization remains Cerbos PDP; User Management owns role-to-user binding.",
      "distribution": "reference",
      "columns": {
        "id": {
          "type": "UUID",
          "nullable": false,
          "default": "gen_random_uuid()"
        },
        "name": {
          "type": "TEXT",
          "nullable": false,
          "description": "Human-readable permission name."
        },
        "slug": {
          "type": "TEXT",
          "nullable": false,
          "description": "Stable permission key referenced in policies and UI gating hints."
        },
        "action": {
          "type": "TEXT",
          "nullable": false,
          "check": "action IN ('create', 'read', 'update', 'delete', 'manage')",
          "description": "Coarse action verb for policy grouping."
        },
        "description": {
          "type": "TEXT",
          "nullable": true
        },
        "is_active": {
          "type": "BOOLEAN",
          "nullable": false,
          "default": "true",
          "description": "Catalog visibility/enabled flag."
        },
        "is_deleted": {
          "type": "BOOLEAN",
          "nullable": false,
          "default": "false",
          "description": "Soft-delete flag; read APIs exclude deleted rows by default."
        },
        "created_by": {
          "type": "UUID",
          "nullable": true,
          "description": "Actor user id when created through authenticated flows."
        },
        "created_at": {
          "type": "TIMESTAMPTZ",
          "nullable": false,
          "default": "now()"
        },
        "updated_by": {
          "type": "UUID",
          "nullable": true,
          "description": "Last modifier user id."
        },
        "updated_at": {
          "type": "TIMESTAMPTZ",
          "nullable": false,
          "default": "now()"
        }
      },
      "primary_key": [
        "id"
      ],
      "indexes": [
        {
          "columns": [
            "slug"
          ],
          "name": "permissions_slug_active_key",
          "unique": true,
          "partial_where": "NOT is_deleted",
          "note": "Unique slug among active rows."
        }
      ]
    },
    "module_permissions": {
      "description": "Maps each module to the permission definitions it exposes or participates in. is_default suggests a starter set for new tenants; Cerbos resource policies remain authoritative at runtime.",
      "distribution": "reference",
      "columns": {
        "id": {
          "type": "UUID",
          "nullable": false,
          "default": "gen_random_uuid()"
        },
        "slug": {
          "type": "TEXT",
          "nullable": false,
          "unique": true,
          "description": "Stable key for this module\u2013permission link (e.g. derived from module and permission slugs)."
        },
        "module_id": {
          "type": "UUID",
          "nullable": false,
          "description": "FK \u2192 modules.id"
        },
        "permission_id": {
          "type": "UUID",
          "nullable": false,
          "description": "FK \u2192 permissions.id"
        },
        "is_default": {
          "type": "BOOLEAN",
          "nullable": false,
          "default": "false",
          "description": "Suggested default inclusion when provisioning tenant role templates."
        },
        "created_at": {
          "type": "TIMESTAMPTZ",
          "nullable": false,
          "default": "now()"
        },
        "updated_at": {
          "type": "TIMESTAMPTZ",
          "nullable": false,
          "default": "now()"
        }
      },
      "primary_key": [
        "id"
      ],
      "unique_constraints": [
        {
          "columns": [
            "module_id",
            "permission_id"
          ],
          "name": "uq_module_permissions_module_permission",
          "note": "One link per module/permission pair"
        }
      ],
      "indexes": [
        {
          "columns": [
            "module_id"
          ],
          "name": "idx_module_permissions_module"
        },
        {
          "columns": [
            "permission_id"
          ],
          "name": "idx_module_permissions_permission"
        },
        {
          "columns": [
            "slug"
          ],
          "name": "idx_module_permissions_slug",
          "unique": true
        }
      ]
    },
    "system_roles": {
      "description": "Named role templates (e.g. Ward Clerk, Lab Supervisor). is_template distinguishes catalog templates from instantiated roles (instantiation and assignment live in User Management). Slugs align with onboarding and policy documentation.",
      "distribution": "reference",
      "columns": {
        "id": {
          "type": "UUID",
          "nullable": false,
          "default": "gen_random_uuid()"
        },
        "name": {
          "type": "TEXT",
          "nullable": false,
          "description": "Display name of the role template."
        },
        "slug": {
          "type": "TEXT",
          "nullable": false,
          "unique": true,
          "description": "Stable role template key."
        },
        "is_template": {
          "type": "BOOLEAN",
          "nullable": false,
          "default": "true",
          "description": "True for platform-shipped templates in this catalog."
        },
        "description": {
          "type": "TEXT",
          "nullable": true
        },
        "created_at": {
          "type": "TIMESTAMPTZ",
          "nullable": false,
          "default": "now()"
        },
        "updated_at": {
          "type": "TIMESTAMPTZ",
          "nullable": false,
          "default": "now()"
        }
      },
      "primary_key": [
        "id"
      ],
      "indexes": [
        {
          "columns": [
            "slug"
          ],
          "name": "idx_system_roles_slug",
          "unique": true
        }
      ]
    },
    "picklist_values": {
      "description": "Values for a picklist domain. category_id → picklist.id; value is the stable stored key; label is locale-default display text; slug is globally unique in this table; metadata holds UI hints (icon, color).",
      "distribution": "reference",
      "columns": {
        "id": {
          "type": "UUID",
          "nullable": false,
          "default": "gen_random_uuid()"
        },
        "slug": {
          "type": "TEXT",
          "nullable": false,
          "unique": true,
          "description": "URL-safe globally unique key (e.g. prefix with picklist slug to avoid collisions across domains)."
        },
        "category_id": {
          "type": "UUID",
          "nullable": false,
          "description": "FK \u2192 picklist.id"
        },
        "value": {
          "type": "TEXT",
          "nullable": false,
          "description": "Stable value key stored in clinical records."
        },
        "label": {
          "type": "TEXT",
          "nullable": false,
          "description": "Default display label."
        },
        "description": {
          "type": "TEXT",
          "nullable": true
        },
        "metadata": {
          "type": "JSONB",
          "nullable": true,
          "description": "Optional JSON for icon, color, FHIR coding hints (Post-launch)."
        },
        "is_active": {
          "type": "BOOLEAN",
          "nullable": false,
          "default": "true"
        },
        "is_default": {
          "type": "BOOLEAN",
          "nullable": false,
          "default": "false"
        },
        "display_order": {
          "type": "INT",
          "nullable": false,
          "default": "0"
        },
        "created_at": {
          "type": "TIMESTAMPTZ",
          "nullable": false,
          "default": "now()"
        },
        "updated_at": {
          "type": "TIMESTAMPTZ",
          "nullable": false,
          "default": "now()"
        }
      },
      "primary_key": [
        "id"
      ],
      "unique_constraints": [
        {
          "columns": [
            "category_id",
            "value"
          ],
          "name": "uq_picklist_values_category_value",
          "note": "No duplicate value keys within a category"
        }
      ],
      "indexes": [
        {
          "columns": [
            "category_id"
          ],
          "name": "idx_picklist_values_category"
        },
        {
          "columns": [
            "category_id",
            "display_order"
          ],
          "name": "idx_picklist_values_order",
          "note": "Ordered dropdown rendering"
        },
        {
          "columns": [
            "slug"
          ],
          "name": "idx_picklist_values_slug",
          "unique": true,
          "note": "Stable external reference"
        }
      ]
    },
    "module_config_schemas": {
      "description": "JSON Schema per module version for Configurator-driven admin UI and validation.",
      "distribution": "reference",
      "columns": {
        "id": {
          "type": "UUID",
          "nullable": false,
          "default": "gen_random_uuid()"
        },
        "slug": {
          "type": "TEXT",
          "nullable": false,
          "unique": true,
          "description": "URL-safe unique key for this schema row (e.g. module slug + schema version)."
        },
        "module_id": {
          "type": "UUID",
          "nullable": false,
          "description": "FK \u2192 modules.id"
        },
        "schema_version": {
          "type": "TEXT",
          "nullable": false,
          "default": "1.0.0"
        },
        "config_schema": {
          "type": "JSONB",
          "nullable": false
        },
        "defaults": {
          "type": "JSONB",
          "nullable": false,
          "default": "{}"
        },
        "created_at": {
          "type": "TIMESTAMPTZ",
          "nullable": false,
          "default": "now()"
        },
        "updated_at": {
          "type": "TIMESTAMPTZ",
          "nullable": false,
          "default": "now()"
        }
      },
      "primary_key": [
        "id"
      ],
      "unique_constraints": [
        {
          "columns": [
            "module_id",
            "schema_version"
          ],
          "name": "uq_module_config_schemas_module_version"
        }
      ],
      "indexes": [
        {
          "columns": [
            "module_id"
          ],
          "name": "idx_module_config_schemas_module"
        },
        {
          "columns": [
            "slug"
          ],
          "name": "idx_module_config_schemas_slug",
          "unique": true
        }
      ]
    },
    "feature_flags": {
      "description": "Platform feature flag definitions. Tenant overrides remain in configurator.tenant_feature_flags.",
      "distribution": "reference",
      "columns": {
        "id": {
          "type": "UUID",
          "nullable": false,
          "default": "gen_random_uuid()"
        },
        "slug": {
          "type": "TEXT",
          "nullable": false,
          "unique": true,
          "description": "URL-safe flag key; may mirror name with normalized casing."
        },
        "name": {
          "type": "TEXT",
          "nullable": false,
          "unique": true
        },
        "description": {
          "type": "TEXT",
          "nullable": true
        },
        "flag_type": {
          "type": "TEXT",
          "nullable": false,
          "default": "boolean",
          "check": "flag_type IN ('boolean', 'percentage', 'string', 'json')"
        },
        "default_value": {
          "type": "JSONB",
          "nullable": false,
          "default": "false"
        },
        "module_id": {
          "type": "UUID",
          "nullable": true,
          "description": "FK \u2192 modules.id; NULL = platform-wide"
        },
        "value_schema": {
          "type": "JSONB",
          "nullable": true
        },
        "created_at": {
          "type": "TIMESTAMPTZ",
          "nullable": false,
          "default": "now()"
        },
        "updated_at": {
          "type": "TIMESTAMPTZ",
          "nullable": false,
          "default": "now()"
        },
        "created_by": {
          "type": "UUID",
          "nullable": true
        },
        "updated_by": {
          "type": "UUID",
          "nullable": true
        }
      },
      "primary_key": [
        "id"
      ],
      "indexes": [
        {
          "columns": [
            "name"
          ],
          "name": "idx_feature_flags_name",
          "unique": true
        },
        {
          "columns": [
            "module_id"
          ],
          "name": "idx_feature_flags_module"
        },
        {
          "columns": [
            "slug"
          ],
          "name": "idx_feature_flags_slug",
          "unique": true
        }
      ]
    },
    "picklist": {
      "description": "Picklist domain header (two-table pattern with picklist_values). Platform-owned reference rows (e.g. gender, marital status).",
      "distribution": "reference",
      "columns": {
        "id": {
          "type": "UUID",
          "nullable": false,
          "default": "gen_random_uuid()"
        },
        "slug": {
          "type": "TEXT",
          "nullable": false,
          "unique": true,
          "description": "URL-safe unique key; often lowercase form of code for APIs and URLs."
        },
        "name": {
          "type": "TEXT",
          "nullable": false,
          "description": "Display title for the category."
        },
        "code": {
          "type": "TEXT",
          "nullable": false,
          "unique": true,
          "description": "Uppercase stable code (e.g. GENDER)."
        },
        "description": {
          "type": "TEXT",
          "nullable": true
        },
        "is_system": {
          "type": "BOOLEAN",
          "nullable": false,
          "default": "true",
          "description": "Platform-defined vs hospital-extended (Post-launch overrides may use separate tables per HLD)."
        },
        "is_active": {
          "type": "BOOLEAN",
          "nullable": false,
          "default": "true"
        },
        "created_at": {
          "type": "TIMESTAMPTZ",
          "nullable": false,
          "default": "now()"
        },
        "updated_at": {
          "type": "TIMESTAMPTZ",
          "nullable": false,
          "default": "now()"
        }
      },
      "primary_key": [
        "id"
      ],
      "indexes": [
        {
          "columns": [
            "code"
          ],
          "name": "idx_picklist_code",
          "unique": true,
          "note": "Uppercase stable code"
        },
        {
          "columns": [
            "slug"
          ],
          "name": "idx_picklist_slug",
          "unique": true,
          "note": "URL-safe lookup"
        }
      ]
    }
  }
}
