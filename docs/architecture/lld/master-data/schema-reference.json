{
  "$schema": "erd/v1",
  "schema": "master_data",
  "description": "Master Data — platform catalog (modules tree, permission definitions, role templates, picklists), Configurator-facing registry (config schemas, feature flags), and audit. Healthcare reference data is Post-launch. See 01-schema-design.md.",
  "citus": {
    "distribution_column": "iq_tenant_id",
    "reference_tables": [
      "modules",
      "permissions",
      "module_permissions",
      "system_roles",
      "picklist_categories",
      "picklist_values",
      "module_config_schemas",
      "feature_flags"
    ],
    "notes": "All catalog/registry tables above are Citus reference tables (replicated). registry_change_audit is distributed by iq_tenant_id."
  },
  "entities": {
    "modules": {
      "description": "Deployable module registry plus admin/navigation tree. Rows are platform-defined (migrations). parent_id forms a bounded hierarchy for menus and IA; name remains the stable API/event identifier; slug is URL-safe and unique for routing.",
      "distribution": "reference",
      "columns": {
        "id": {
          "type": "UUID",
          "nullable": false,
          "default": "gen_random_uuid()"
        },
        "parent_id": {
          "type": "UUID",
          "nullable": true,
          "description": "Parent module for tree (NULL = root). FK → modules.id. ON DELETE RESTRICT recommended to avoid orphaning children."
        },
        "name": {
          "type": "TEXT",
          "nullable": false,
          "unique": true,
          "description": "Stable machine name (e.g. opd, user_management). Used in APIs, events, cross-module references."
        },
        "slug": {
          "type": "TEXT",
          "nullable": false,
          "unique": true,
          "description": "URL-safe unique key for SPA routes and external links."
        },
        "display_name": {
          "type": "TEXT",
          "nullable": false,
          "description": "Human-readable label for admin UI."
        },
        "description": {
          "type": "TEXT",
          "nullable": true,
          "description": "Purpose summary."
        },
        "category": {
          "type": "TEXT",
          "nullable": false,
          "check": "category IN ('core', 'clinical', 'administrative', 'support')"
        },
        "is_core": {
          "type": "BOOLEAN",
          "nullable": false,
          "default": "false",
          "description": "Four core modules (User Management, EMPI, Configurator, Master Data). Configurator provisioning uses this as source of truth."
        },
        "version": {
          "type": "TEXT",
          "nullable": false,
          "default": "0.0.0",
          "description": "Deployed semver; updated by module migrations."
        },
        "level": {
          "type": "INT",
          "nullable": false,
          "default": "1",
          "check": "level >= 1 AND level <= 4",
          "description": "Tree depth for menus (bounded to avoid deep nesting)."
        },
        "icon": {
          "type": "TEXT",
          "nullable": true,
          "description": "UI icon token (design system key)."
        },
        "route_path": {
          "type": "TEXT",
          "nullable": true,
          "description": "Default SPA route path for this module entry (nullable for grouping-only nodes)."
        },
        "is_active": {
          "type": "BOOLEAN",
          "nullable": false,
          "default": "true",
          "description": "Catalog visibility; inactive nodes hidden from default admin navigation."
        },
        "created_at": {
          "type": "TIMESTAMPTZ",
          "nullable": false,
          "default": "now()"
        },
        "updated_at": {
          "type": "TIMESTAMPTZ",
          "nullable": false,
          "default": "now()"
        }
      },
      "primary_key": ["id"],
      "indexes": [
        {
          "columns": ["name"],
          "name": "idx_modules_name",
          "unique": true,
          "note": "Lookup by machine name"
        },
        {
          "columns": ["slug"],
          "name": "idx_modules_slug",
          "unique": true,
          "note": "Lookup by slug / routing"
        },
        {
          "columns": ["parent_id"],
          "name": "idx_modules_parent",
          "note": "List children for tree build"
        },
        {
          "columns": ["category"],
          "name": "idx_modules_category",
          "note": "Filter catalog by category"
        }
      ]
    },

    "permissions": {
      "description": "Platform permission definitions (labels, slugs, actions). These are catalog rows — not user assignments. Effective authorization remains Cerbos PDP; User Management owns role-to-user binding.",
      "distribution": "reference",
      "columns": {
        "id": {
          "type": "UUID",
          "nullable": false,
          "default": "gen_random_uuid()"
        },
        "name": {
          "type": "TEXT",
          "nullable": false,
          "description": "Human-readable permission name."
        },
        "slug": {
          "type": "TEXT",
          "nullable": false,
          "unique": true,
          "description": "Stable permission key referenced in policies and UI gating hints."
        },
        "action": {
          "type": "TEXT",
          "nullable": false,
          "check": "action IN ('create', 'read', 'update', 'delete', 'manage')",
          "description": "Coarse action verb for policy grouping."
        },
        "description": {
          "type": "TEXT",
          "nullable": true
        },
        "created_at": {
          "type": "TIMESTAMPTZ",
          "nullable": false,
          "default": "now()"
        },
        "updated_at": {
          "type": "TIMESTAMPTZ",
          "nullable": false,
          "default": "now()"
        }
      },
      "primary_key": ["id"],
      "indexes": [
        {
          "columns": ["slug"],
          "name": "idx_permissions_slug",
          "unique": true
        }
      ]
    },

    "module_permissions": {
      "description": "Maps each module to the permission definitions it exposes or participates in. is_default suggests a starter set for new tenants; Cerbos resource policies remain authoritative at runtime.",
      "distribution": "reference",
      "columns": {
        "id": {
          "type": "UUID",
          "nullable": false,
          "default": "gen_random_uuid()"
        },
        "module_id": {
          "type": "UUID",
          "nullable": false,
          "description": "FK → modules.id"
        },
        "permission_id": {
          "type": "UUID",
          "nullable": false,
          "description": "FK → permissions.id"
        },
        "is_default": {
          "type": "BOOLEAN",
          "nullable": false,
          "default": "false",
          "description": "Suggested default inclusion when provisioning tenant role templates."
        },
        "created_at": {
          "type": "TIMESTAMPTZ",
          "nullable": false,
          "default": "now()"
        },
        "updated_at": {
          "type": "TIMESTAMPTZ",
          "nullable": false,
          "default": "now()"
        }
      },
      "primary_key": ["id"],
      "unique_constraints": [
        {
          "columns": ["module_id", "permission_id"],
          "name": "uq_module_permissions_module_permission",
          "note": "One link per module/permission pair"
        }
      ],
      "indexes": [
        {
          "columns": ["module_id"],
          "name": "idx_module_permissions_module"
        },
        {
          "columns": ["permission_id"],
          "name": "idx_module_permissions_permission"
        }
      ]
    },

    "system_roles": {
      "description": "Named role templates (e.g. Ward Clerk, Lab Supervisor). is_template distinguishes catalog templates from instantiated roles (instantiation and assignment live in User Management). Slugs align with onboarding and policy documentation.",
      "distribution": "reference",
      "columns": {
        "id": {
          "type": "UUID",
          "nullable": false,
          "default": "gen_random_uuid()"
        },
        "name": {
          "type": "TEXT",
          "nullable": false,
          "description": "Display name of the role template."
        },
        "slug": {
          "type": "TEXT",
          "nullable": false,
          "unique": true,
          "description": "Stable role template key."
        },
        "is_template": {
          "type": "BOOLEAN",
          "nullable": false,
          "default": "true",
          "description": "True for platform-shipped templates in this catalog."
        },
        "description": {
          "type": "TEXT",
          "nullable": true
        },
        "created_at": {
          "type": "TIMESTAMPTZ",
          "nullable": false,
          "default": "now()"
        },
        "updated_at": {
          "type": "TIMESTAMPTZ",
          "nullable": false,
          "default": "now()"
        }
      },
      "primary_key": ["id"],
      "indexes": [
        {
          "columns": ["slug"],
          "name": "idx_system_roles_slug",
          "unique": true
        }
      ]
    },

    "picklist_categories": {
      "description": "Picklist domain (two-table pattern). Categories are platform-owned reference entries (e.g. GENDER, MARITAL_STATUS).",
      "distribution": "reference",
      "columns": {
        "id": {
          "type": "UUID",
          "nullable": false,
          "default": "gen_random_uuid()"
        },
        "name": {
          "type": "TEXT",
          "nullable": false,
          "description": "Display title for the category."
        },
        "code": {
          "type": "TEXT",
          "nullable": false,
          "unique": true,
          "description": "Uppercase stable code (e.g. GENDER)."
        },
        "description": {
          "type": "TEXT",
          "nullable": true
        },
        "is_system": {
          "type": "BOOLEAN",
          "nullable": false,
          "default": "true",
          "description": "Platform-defined vs hospital-extended (Post-launch overrides may use separate tables per HLD)."
        },
        "is_active": {
          "type": "BOOLEAN",
          "nullable": false,
          "default": "true"
        },
        "created_at": {
          "type": "TIMESTAMPTZ",
          "nullable": false,
          "default": "now()"
        },
        "updated_at": {
          "type": "TIMESTAMPTZ",
          "nullable": false,
          "default": "now()"
        }
      },
      "primary_key": ["id"],
      "indexes": [
        {
          "columns": ["code"],
          "name": "idx_picklist_categories_code",
          "unique": true
        }
      ]
    },

    "picklist_values": {
      "description": "Values for a picklist category. value is the stable stored key; label is locale-default display text; metadata holds UI hints (icon, color).",
      "distribution": "reference",
      "columns": {
        "id": {
          "type": "UUID",
          "nullable": false,
          "default": "gen_random_uuid()"
        },
        "category_id": {
          "type": "UUID",
          "nullable": false,
          "description": "FK → picklist_categories.id"
        },
        "value": {
          "type": "TEXT",
          "nullable": false,
          "description": "Stable value key stored in clinical records."
        },
        "label": {
          "type": "TEXT",
          "nullable": false,
          "description": "Default display label."
        },
        "description": {
          "type": "TEXT",
          "nullable": true
        },
        "metadata": {
          "type": "JSONB",
          "nullable": true,
          "description": "Optional JSON for icon, color, FHIR coding hints (Post-launch)."
        },
        "is_active": {
          "type": "BOOLEAN",
          "nullable": false,
          "default": "true"
        },
        "is_default": {
          "type": "BOOLEAN",
          "nullable": false,
          "default": "false"
        },
        "display_order": {
          "type": "INT",
          "nullable": false,
          "default": "0"
        },
        "created_at": {
          "type": "TIMESTAMPTZ",
          "nullable": false,
          "default": "now()"
        },
        "updated_at": {
          "type": "TIMESTAMPTZ",
          "nullable": false,
          "default": "now()"
        }
      },
      "primary_key": ["id"],
      "unique_constraints": [
        {
          "columns": ["category_id", "value"],
          "name": "uq_picklist_values_category_value",
          "note": "No duplicate value keys within a category"
        }
      ],
      "indexes": [
        {
          "columns": ["category_id"],
          "name": "idx_picklist_values_category"
        },
        {
          "columns": ["category_id", "display_order"],
          "name": "idx_picklist_values_order",
          "note": "Ordered dropdown rendering"
        }
      ]
    },

    "module_config_schemas": {
      "description": "JSON Schema per module version for Configurator-driven admin UI and validation.",
      "distribution": "reference",
      "columns": {
        "id": {
          "type": "UUID",
          "nullable": false,
          "default": "gen_random_uuid()"
        },
        "module_id": {
          "type": "UUID",
          "nullable": false,
          "description": "FK → modules.id"
        },
        "schema_version": {
          "type": "TEXT",
          "nullable": false,
          "default": "1.0.0"
        },
        "config_schema": {
          "type": "JSONB",
          "nullable": false
        },
        "defaults": {
          "type": "JSONB",
          "nullable": false,
          "default": "{}"
        },
        "created_at": {
          "type": "TIMESTAMPTZ",
          "nullable": false,
          "default": "now()"
        },
        "updated_at": {
          "type": "TIMESTAMPTZ",
          "nullable": false,
          "default": "now()"
        }
      },
      "primary_key": ["id"],
      "unique_constraints": [
        {
          "columns": ["module_id", "schema_version"],
          "name": "uq_module_config_schemas_module_version"
        }
      ],
      "indexes": [
        {
          "columns": ["module_id"],
          "name": "idx_module_config_schemas_module"
        }
      ]
    },

    "feature_flags": {
      "description": "Platform feature flag definitions. Tenant overrides remain in configurator.tenant_feature_flags.",
      "distribution": "reference",
      "columns": {
        "id": {
          "type": "UUID",
          "nullable": false,
          "default": "gen_random_uuid()"
        },
        "name": {
          "type": "TEXT",
          "nullable": false,
          "unique": true
        },
        "description": {
          "type": "TEXT",
          "nullable": true
        },
        "flag_type": {
          "type": "TEXT",
          "nullable": false,
          "default": "boolean",
          "check": "flag_type IN ('boolean', 'percentage', 'string', 'json')"
        },
        "default_value": {
          "type": "JSONB",
          "nullable": false,
          "default": "false"
        },
        "module_id": {
          "type": "UUID",
          "nullable": true,
          "description": "FK → modules.id; NULL = platform-wide"
        },
        "value_schema": {
          "type": "JSONB",
          "nullable": true
        },
        "created_at": {
          "type": "TIMESTAMPTZ",
          "nullable": false,
          "default": "now()"
        },
        "updated_at": {
          "type": "TIMESTAMPTZ",
          "nullable": false,
          "default": "now()"
        },
        "created_by": {
          "type": "UUID",
          "nullable": true
        },
        "updated_by": {
          "type": "UUID",
          "nullable": true
        }
      },
      "primary_key": ["id"],
      "indexes": [
        {
          "columns": ["name"],
          "name": "idx_feature_flags_name",
          "unique": true
        },
        {
          "columns": ["module_id"],
          "name": "idx_feature_flags_module"
        }
      ]
    },

    "registry_change_audit": {
      "description": "Append-only audit for changes to all MVP catalog and registry entities in this schema.",
      "distribution": "distributed",
      "columns": {
        "iq_tenant_id": {
          "type": "UUID",
          "nullable": false,
          "description": "Citus shard key — actor tenant from JWT, or platform-operations tenant for migration writes."
        },
        "id": {
          "type": "UUID",
          "nullable": false,
          "default": "gen_random_uuid()"
        },
        "entity_type": {
          "type": "TEXT",
          "nullable": false,
          "check": "entity_type IN ('module', 'module_config_schema', 'feature_flag', 'permission', 'module_permission', 'system_role', 'picklist_category', 'picklist_value')",
          "description": "Which catalog entity changed"
        },
        "entity_id": {
          "type": "UUID",
          "nullable": false
        },
        "action": {
          "type": "TEXT",
          "nullable": false,
          "check": "action IN ('created', 'updated')"
        },
        "old_value": {
          "type": "JSONB",
          "nullable": true
        },
        "new_value": {
          "type": "JSONB",
          "nullable": true
        },
        "changed_by": {
          "type": "UUID",
          "nullable": true
        },
        "changed_at": {
          "type": "TIMESTAMPTZ",
          "nullable": false,
          "default": "now()"
        }
      },
      "primary_key": ["iq_tenant_id", "id"],
      "indexes": [
        {
          "columns": ["iq_tenant_id", "entity_type"],
          "name": "idx_registry_change_audit_type"
        },
        {
          "columns": ["iq_tenant_id", "entity_id"],
          "name": "idx_registry_change_audit_entity"
        },
        {
          "columns": ["iq_tenant_id", "changed_at"],
          "name": "idx_registry_change_audit_time"
        }
      ]
    }
  }
}
