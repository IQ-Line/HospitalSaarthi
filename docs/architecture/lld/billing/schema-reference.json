  "departures_from_lead_erd": {
    "removed": {
      "patients": "Patient identity owned by EMPI per ADR-0007 and CLAUDE.md (no cross-module patient ownership). Billing carries patient_id UUID soft reference.",
      "billing_audit_log": "Audit deferred to centralized HTTP middleware + CDC per ADR-0024. No per-module audit tables."
    },
    "added": {
      "iq_tenant_id": "Multi-tenancy column on every table per ADR-0012. Lead's ERD had no tenant scoping.",
      "service_master.provider_id": "Soft ref (nullable UUID) to the doctor/staff record in User Management. Enables per-doctor consultation pricing in Phase 1 without introducing the price_agreements abstraction. The unique index `(iq_tenant_id, service_code, provider_id) NULLS NOT DISTINCT` allows one rack-rate row plus per-provider override rows for the same service_code. Phase 2 migration can fold these into a single rack-rate row + DOCTOR_OVERRIDE agreements; historical bill_items unaffected due to snapshot pricing.",
      "bill_items.source_module": "Required to identify which clinical module emitted the charge; supports reverse lookup from clinical row.",
      "bill_items.source_ref": "Clinical row ID for reverse lookup.",
      "bill_items.idempotency_key": "Charge-ingest idempotency."
    },
    "renamed": {
      "bills.advance_ids": "Replaced with explicit advance_utilizations rows (lead had JSONB array; we model as first-class rows in Phase 2)."
    },
    "phase_1_column_trim_2026_05_14": {
      "context": "Lead reviewed the Phase 1 ERD on PR #48 and flagged that several columns were either clinical-coding leftovers from the vibe-coded source ERD or product-driven concerns that should not appear until product asks. We deferred those columns to Phase 2+ to keep the dev's mental model aligned with existing-prod OPD counter flow.",
      "service_master_dropped": [
        "hsn_sac_code", "icd_10_code", "cpt_code", "hcpcs_code", "duration_minutes", "is_insurance_covered", "tax_category", "requires_pre_authorization", "requires_doctor_approval", "is_emergency_service", "effective_from", "effective_to"
      ],
      "bills_dropped": [
        "bill_category", "due_date", "discharge_date", "discount_percentage", "advance_adjusted", "insurance_claim_amount", "insurance_approved_amount", "insurance_paid_amount", "insurance_rejected_amount", "patient_payable", "payment_status", "parent_bill_id", "replaced_bill_id", "corporate_client_id", "employee_id", "employee_name", "policy_id", "internal_notes"
      ],
      "bill_items_dropped": [
        "price_agreement_id", "package_id", "is_insurance_covered", "tax_category", "insurance_claim_amount", "insurance_approved_amount", "insurance_rejection_reason", "patient_share", "unit"
      ],
      "payments_dropped": [
        "claim_id", "tds_deducted", "payment_gateway", "gateway_response", "authorization_code", "card_type", "card_last4", "card_holder_name", "upi_id", "upi_transaction_id", "bank_name", "branch_name", "cheque_number", "cheque_date", "verified_by", "verified_at", "remarks"
      ],
      "enum_revisions": {
        "payments.payment_method": "Phase 1: CASH | CARD | UPI | CHEQUE | BANK_TRANSFER. Dropped GATEWAY, ADVANCE_RECEIPT, ADVANCE_UTILIZATION, INSURANCE_DISBURSEMENT, CORPORATE_INVOICE (Phase 2 concepts).",
        "payments.status": "Phase 1: SUCCESS | FAILED | VOIDED. Dropped PENDING_GATEWAY (no online gateway in Phase 1)."
      }
    }
  }
}
