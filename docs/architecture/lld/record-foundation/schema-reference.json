{
  "$schema": "erd/v1",
  "schema": "record_foundation",
  "description": "Record Foundation — simplified module with care-context registry and FHIR Document Bundle vault. 2 tables only.",
  "citus": {
    "distribution_column": "iq_tenant_id",
    "reference_tables": [],
    "rationale": "All Record Foundation data is patient-scoped, hence tenant-scoped."
  },
  "phasing": {
    "Phase_0": "Schema implemented. Tables created. Consumers being wired in Phase 1."
  },
  "entities": {
    "care_contexts": {
      "description": "The discoverable health-record units. One row per (patient, source clinical event). Tracks origin, type, and time window.",
      "distribution": "distributed_by_iq_tenant_id",
      "columns": {
        "id": {"type": "UUID", "nullable": false, "default": "gen_random_uuid()"},
        "iq_tenant_id": {"type": "UUID", "nullable": false},
        "patient_id": {"type": "UUID", "nullable": false, "description": "EMPI patient_id."},
        "source_origin": {"type": "TEXT", "nullable": false, "check": "source_origin IN ('platform_module','legacy_system','external_abdm')"},
        "source_system_id": {"type": "TEXT", "nullable": false},
        "source_record_type": {"type": "TEXT", "nullable": false},
        "source_record_id": {"type": "TEXT", "nullable": true},
        "encounter_id": {"type": "UUID", "nullable": true},
        "display": {"type": "TEXT", "nullable": false},
        "period_start": {"type": "TIMESTAMPTZ", "nullable": false},
        "period_end": {"type": "TIMESTAMPTZ", "nullable": true},
        "status": {"type": "TEXT", "nullable": false, "default": "active"},
        "created_at": {"type": "TIMESTAMPTZ", "nullable": false, "default": "now()"},
        "updated_at": {"type": "TIMESTAMPTZ", "nullable": false, "default": "now()"},
        "created_by": {"type": "UUID", "nullable": true},
        "updated_by": {"type": "UUID", "nullable": true}
      },
      "primary_key": ["iq_tenant_id", "id"],
      "indexes": [
        {"columns": ["iq_tenant_id", "patient_id", "period_start"], "name": "idx_care_contexts_patient_time"},
        {"columns": ["iq_tenant_id", "source_origin", "source_system_id", "source_record_id", "source_record_type"], "name": "uq_care_contexts_source", "unique": true}
      ]
    },
    "bundles": {
      "description": "FHIR Document Bundles stored as inline JSONB. INSERT-only: rows are NEVER updated.",
      "distribution": "distributed_by_iq_tenant_id",
      "columns": {
        "id": {"type": "UUID", "nullable": false, "default": "gen_random_uuid()"},
        "iq_tenant_id": {"type": "UUID", "nullable": false},
        "care_context_id": {"type": "UUID", "nullable": false},
        "bundle_kind": {"type": "TEXT", "nullable": false},
        "fhir_profile_url": {"type": "TEXT", "nullable": false},
        "fhir_profile_version": {"type": "TEXT", "nullable": false},
        "producer_kind": {"type": "TEXT", "nullable": false},
        "producer_id": {"type": "TEXT", "nullable": false},
        "bundle_json": {"type": "JSONB", "nullable": false},
        "bundle_size_bytes": {"type": "INTEGER", "nullable": false},
        "produced_at": {"type": "TIMESTAMPTZ", "nullable": false},
        "stored_at": {"type": "TIMESTAMPTZ", "nullable": false, "default": "now()"},
        "created_at": {"type": "TIMESTAMPTZ", "nullable": false, "default": "now()"},
        "updated_at": {"type": "TIMESTAMPTZ", "nullable": false, "default": "now()"},
        "created_by": {"type": "UUID", "nullable": true},
        "updated_by": {"type": "UUID", "nullable": true}
      },
      "primary_key": ["iq_tenant_id", "id"],
      "indexes": [
        {"columns": ["iq_tenant_id", "care_context_id"], "name": "idx_bundles_care_context"},
        {"columns": ["iq_tenant_id", "bundle_kind"], "name": "idx_bundles_kind"}
      ]
    }
  },
  "events": {
    "published": [
      {
        "name": "record-foundation.care-context.registered",
        "payload_fields": ["care_context_id", "patient_id", "source_origin", "source_record_type", "display", "period_start", "period_end", "iq_tenant_id"]
      },
      {
        "name": "record-foundation.bundle.stored",
        "payload_fields": ["bundle_id", "care_context_id", "bundle_kind", "fhir_profile_url", "iq_tenant_id"]
      }
    ],
    "consumed": [
      {
        "name": "consultation.finalized",
        "publisher": "modules/opd",
        "description": "Triggers care_context registration + bundle storage."
      },
      {
        "name": "lab-report.finalized",
        "publisher": "modules/lab",
        "description": "(Phase 1.5) Triggers care_context + bundle for a finalised lab report."
      },
      {
        "name": "discharge-summary.signed",
        "publisher": "modules/ipd",
        "description": "(Phase 2) Triggers care_context + bundle for a signed discharge summary."
      }
    ]
  }
}
