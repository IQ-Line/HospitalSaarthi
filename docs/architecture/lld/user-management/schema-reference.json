{
  "$schema": "erd/v1",
  "schema": "user_management",
  "description": "User Management core module \u2014 identity authority, AuthZ data (Layer 3), and better-auth AuthN tables (Layer 1). See 01-schema-design.md for rationale.",
  "citus": {
    "distribution_column": "iq_tenant_id",
    "reference_tables": [
      "capabilities"
    ]
  },
  "entities": {
    "users": {
      "description": "Every principal that acts on the system. One row per tenant \u2014 a user at two hospitals has two rows linked by auth_user_id.",
      "distribution": "distributed",
      "columns": {
        "iq_tenant_id": {
          "type": "UUID",
          "nullable": false,
          "description": "Citus distribution key \u2014 tenant this user record belongs to"
        },
        "id": {
          "type": "UUID",
          "nullable": false,
          "default": "gen_random_uuid()"
        },
        "auth_user_id": {
          "type": "UUID",
          "nullable": true,
          "description": "Links to ba_users.id \u2014 shared across tenants for the same human. Null for service accounts."
        },
        "kind": {
          "type": "TEXT",
          "nullable": false,
          "default": "user",
          "check": "kind IN ('user', 'service', 'agent')"
        },
        "org_id": {
          "type": "UUID",
          "nullable": true,
          "description": "Organization ID for multi-hospital users. Null for single-tenant users."
        },
        "employee_id": {
          "type": "TEXT",
          "nullable": true,
          "description": "Hospital's own staff identifier (HR system ID, badge number)"
        },
        "full_name": {
          "type": "TEXT",
          "nullable": false
        },
        "email": {
          "type": "TEXT",
          "nullable": true
        },
        "phone": {
          "type": "TEXT",
          "nullable": true
        },
        "status": {
          "type": "TEXT",
          "nullable": false,
          "default": "active",
          "check": "status IN ('active', 'inactive', 'suspended')"
        },
        "recovery_tier": {
          "type": "TEXT",
          "nullable": false,
          "default": "admin_only",
          "check": "recovery_tier IN ('standard', 'delegated', 'phone_recovery', 'admin_only', 'federated')",
          "description": "Governs which recovery paths are available when user is locked out. See 01-schema-design.md §15."
        },
        "phone_auth_enabled": {
          "type": "BOOLEAN",
          "nullable": false,
          "default": false,
          "description": "Whether this user's phone number can be used for OTP-based login and recovery. False if phone is shared."
        },
        "must_change_password": {
          "type": "BOOLEAN",
          "nullable": false,
          "default": false,
          "description": "When true, user must change password before accessing clinical modules. Set by admin recovery Flow A."
        },
        "created_at": {
          "type": "TIMESTAMPTZ",
          "nullable": false,
          "default": "now()"
        },
        "updated_at": {
          "type": "TIMESTAMPTZ",
          "nullable": false,
          "default": "now()"
        },
        "created_by": {
          "type": "UUID",
          "nullable": true
        },
        "updated_by": {
          "type": "UUID",
          "nullable": true
        }
      },
      "primary_key": [
        "iq_tenant_id",
        "id"
      ],
      "indexes": [
        {
          "columns": [
            "iq_tenant_id",
            "auth_user_id"
          ],
          "name": "idx_users_auth_user",
          "note": "Lookup all tenant records for a given auth identity (multi-tenant login)"
        },
        {
          "columns": [
            "iq_tenant_id",
            "email"
          ],
          "name": "idx_users_email"
        },
        {
          "columns": [
            "iq_tenant_id",
            "status"
          ],
          "name": "idx_users_status"
        },
        {
          "columns": [
            "iq_tenant_id",
            "org_id"
          ],
          "name": "idx_users_org",
          "where": "org_id IS NOT NULL"
        }
      ]
    },
    "roles": {
      "description": "Role definitions. Tenant-scoped. Roles are flat containers of capabilities \u2014 no inheritance.",
      "distribution": "distributed",
      "columns": {
        "iq_tenant_id": {
          "type": "UUID",
          "nullable": false
        },
        "id": {
          "type": "UUID",
          "nullable": false,
          "default": "gen_random_uuid()"
        },
        "name": {
          "type": "TEXT",
          "nullable": false,
          "description": "System name, e.g. 'attending-physician', 'charge-nurse'"
        },
        "display_name": {
          "type": "TEXT",
          "nullable": false
        },
        "description": {
          "type": "TEXT",
          "nullable": true
        },
        "scope_level": {
          "type": "TEXT",
          "nullable": false,
          "default": "tenant",
          "check": "scope_level IN ('tenant', 'organization')"
        },
        "is_system": {
          "type": "BOOLEAN",
          "nullable": false,
          "default": false,
          "description": "Platform-seeded roles that tenants cannot delete"
        },
        "status": {
          "type": "TEXT",
          "nullable": false,
          "default": "active",
          "check": "status IN ('active', 'archived')"
        },
        "created_at": {
          "type": "TIMESTAMPTZ",
          "nullable": false,
          "default": "now()"
        },
        "updated_at": {
          "type": "TIMESTAMPTZ",
          "nullable": false,
          "default": "now()"
        },
        "created_by": {
          "type": "UUID",
          "nullable": true
        },
        "updated_by": {
          "type": "UUID",
          "nullable": true
        }
      },
      "primary_key": [
        "iq_tenant_id",
        "id"
      ],
      "unique_constraints": [
        {
          "columns": [
            "iq_tenant_id",
            "name"
          ],
          "name": "uq_roles_name"
        }
      ],
      "indexes": [
        {
          "columns": [
            "iq_tenant_id",
            "scope_level"
          ],
          "name": "idx_roles_scope"
        }
      ]
    },
    "capabilities": {
      "description": "Platform-defined atomic authorization actions. Citus REFERENCE table \u2014 replicated to all nodes, same for all tenants.",
      "distribution": "reference",
      "columns": {
        "id": {
          "type": "UUID",
          "nullable": false,
          "default": "gen_random_uuid()"
        },
        "module": {
          "type": "TEXT",
          "nullable": false,
          "description": "Owning module: 'opd', 'lab', 'pharmacy', 'admin', 'org'"
        },
        "name": {
          "type": "TEXT",
          "nullable": false,
          "description": "Colon-separated hierarchical identifier, e.g. 'opd:registration:search:advanced'"
        },
        "display_name": {
          "type": "TEXT",
          "nullable": false
        },
        "description": {
          "type": "TEXT",
          "nullable": true
        },
        "is_assignable": {
          "type": "BOOLEAN",
          "nullable": false,
          "default": true,
          "description": "False for capabilities reserved for platform internals (not shown in admin UI)"
        },
        "sort_order": {
          "type": "INTEGER",
          "nullable": false,
          "default": 0,
          "description": "Controls display order within a module group in the admin UI"
        },
        "created_at": {
          "type": "TIMESTAMPTZ",
          "nullable": false,
          "default": "now()"
        },
        "updated_at": {
          "type": "TIMESTAMPTZ",
          "nullable": false,
          "default": "now()"
        }
      },
      "primary_key": [
        "id"
      ],
      "unique_constraints": [
        {
          "columns": [
            "name"
          ],
          "name": "uq_capabilities_name"
        }
      ],
      "indexes": [
        {
          "columns": [
            "module"
          ],
          "name": "idx_capabilities_module"
        }
      ]
    },
    "role_capabilities": {
      "description": "Maps roles to capabilities. Tenant-scoped \u2014 Hospital A's 'Nurse' role may have different capabilities than Hospital B's.",
      "distribution": "distributed",
      "columns": {
        "iq_tenant_id": {
          "type": "UUID",
          "nullable": false
        },
        "id": {
          "type": "UUID",
          "nullable": false,
          "default": "gen_random_uuid()"
        },
        "role_id": {
          "type": "UUID",
          "nullable": false
        },
        "capability_id": {
          "type": "UUID",
          "nullable": false
        },
        "created_at": {
          "type": "TIMESTAMPTZ",
          "nullable": false,
          "default": "now()"
        },
        "created_by": {
          "type": "UUID",
          "nullable": true
        }
      },
      "primary_key": [
        "iq_tenant_id",
        "id"
      ],
      "unique_constraints": [
        {
          "columns": [
            "iq_tenant_id",
            "role_id",
            "capability_id"
          ],
          "name": "uq_role_capabilities"
        }
      ],
      "foreign_keys": [
        {
          "columns": [
            "iq_tenant_id",
            "role_id"
          ],
          "references": {
            "table": "roles",
            "columns": [
              "iq_tenant_id",
              "id"
            ]
          }
        },
        {
          "columns": [
            "capability_id"
          ],
          "references": {
            "table": "capabilities",
            "columns": [
              "id"
            ]
          },
          "note": "FK to reference table \u2014 valid in Citus"
        }
      ]
    },
    "role_assignments": {
      "description": "Assigns roles to users, optionally scoped to a department or ward.",
      "distribution": "distributed",
      "columns": {
        "iq_tenant_id": {
          "type": "UUID",
          "nullable": false
        },
        "id": {
          "type": "UUID",
          "nullable": false,
          "default": "gen_random_uuid()"
        },
        "user_id": {
          "type": "UUID",
          "nullable": false
        },
        "role_id": {
          "type": "UUID",
          "nullable": false
        },
        "scope_type": {
          "type": "TEXT",
          "nullable": true,
          "check": "scope_type IN ('department', 'ward')",
          "description": "Null = tenant-wide role"
        },
        "scope_id": {
          "type": "UUID",
          "nullable": true,
          "description": "Department or ward ID. Null when scope_type is null."
        },
        "assigned_at": {
          "type": "TIMESTAMPTZ",
          "nullable": false,
          "default": "now()"
        },
        "assigned_by": {
          "type": "UUID",
          "nullable": false
        },
        "revoked_at": {
          "type": "TIMESTAMPTZ",
          "nullable": true,
          "description": "Null = currently active"
        },
        "revoked_by": {
          "type": "UUID",
          "nullable": true
        }
      },
      "primary_key": [
        "iq_tenant_id",
        "id"
      ],
      "foreign_keys": [
        {
          "columns": [
            "iq_tenant_id",
            "user_id"
          ],
          "references": {
            "table": "users",
            "columns": [
              "iq_tenant_id",
              "id"
            ]
          }
        },
        {
          "columns": [
            "iq_tenant_id",
            "role_id"
          ],
          "references": {
            "table": "roles",
            "columns": [
              "iq_tenant_id",
              "id"
            ]
          }
        }
      ],
      "indexes": [
        {
          "columns": [
            "iq_tenant_id",
            "user_id",
            "revoked_at"
          ],
          "name": "idx_role_assignments_user_active",
          "note": "Active assignments lookup: WHERE revoked_at IS NULL"
        },
        {
          "columns": [
            "iq_tenant_id",
            "role_id"
          ],
          "name": "idx_role_assignments_role"
        }
      ]
    },
    "user_department_assignments": {
      "description": "Links users to departments with lifecycle. A user can belong to multiple departments; one is primary.",
      "distribution": "distributed",
      "columns": {
        "iq_tenant_id": {
          "type": "UUID",
          "nullable": false
        },
        "id": {
          "type": "UUID",
          "nullable": false,
          "default": "gen_random_uuid()"
        },
        "user_id": {
          "type": "UUID",
          "nullable": false
        },
        "department_id": {
          "type": "UUID",
          "nullable": false,
          "description": "References department_projection (no FK \u2014 cross-entity boundary)"
        },
        "is_primary": {
          "type": "BOOLEAN",
          "nullable": false,
          "default": false
        },
        "effective_from": {
          "type": "DATE",
          "nullable": false
        },
        "effective_to": {
          "type": "DATE",
          "nullable": true,
          "description": "Null = currently active"
        },
        "created_at": {
          "type": "TIMESTAMPTZ",
          "nullable": false,
          "default": "now()"
        },
        "created_by": {
          "type": "UUID",
          "nullable": true
        }
      },
      "primary_key": [
        "iq_tenant_id",
        "id"
      ],
      "foreign_keys": [
        {
          "columns": [
            "iq_tenant_id",
            "user_id"
          ],
          "references": {
            "table": "users",
            "columns": [
              "iq_tenant_id",
              "id"
            ]
          }
        }
      ],
      "indexes": [
        {
          "columns": [
            "iq_tenant_id",
            "user_id",
            "effective_to"
          ],
          "name": "idx_dept_assignments_user_active",
          "note": "Active assignments: WHERE effective_to IS NULL"
        },
        {
          "columns": [
            "iq_tenant_id",
            "department_id"
          ],
          "name": "idx_dept_assignments_dept"
        }
      ]
    },
    "delegations": {
      "description": "Time-bounded delegation of authority. A superintendent delegates approval to a deputy for 2 weeks.",
      "distribution": "distributed",
      "columns": {
        "iq_tenant_id": {
          "type": "UUID",
          "nullable": false
        },
        "id": {
          "type": "UUID",
          "nullable": false,
          "default": "gen_random_uuid()"
        },
        "delegator_id": {
          "type": "UUID",
          "nullable": false,
          "description": "User granting the delegation"
        },
        "delegatee_id": {
          "type": "UUID",
          "nullable": false,
          "description": "User receiving the delegation"
        },
        "delegation_type": {
          "type": "TEXT",
          "nullable": false,
          "check": "delegation_type IN ('role', 'capability')"
        },
        "delegated_role_id": {
          "type": "UUID",
          "nullable": true,
          "description": "Set when delegation_type = 'role'"
        },
        "delegated_capability_id": {
          "type": "UUID",
          "nullable": true,
          "description": "Set when delegation_type = 'capability'"
        },
        "reason": {
          "type": "TEXT",
          "nullable": false
        },
        "effective_from": {
          "type": "TIMESTAMPTZ",
          "nullable": false
        },
        "effective_to": {
          "type": "TIMESTAMPTZ",
          "nullable": false
        },
        "status": {
          "type": "TEXT",
          "nullable": false,
          "default": "active",
          "check": "status IN ('active', 'revoked', 'expired')"
        },
        "revoked_by": {
          "type": "UUID",
          "nullable": true
        },
        "revoked_at": {
          "type": "TIMESTAMPTZ",
          "nullable": true
        },
        "created_at": {
          "type": "TIMESTAMPTZ",
          "nullable": false,
          "default": "now()"
        },
        "created_by": {
          "type": "UUID",
          "nullable": true
        }
      },
      "primary_key": [
        "iq_tenant_id",
        "id"
      ],
      "foreign_keys": [
        {
          "columns": [
            "iq_tenant_id",
            "delegator_id"
          ],
          "references": {
            "table": "users",
            "columns": [
              "iq_tenant_id",
              "id"
            ]
          }
        },
        {
          "columns": [
            "iq_tenant_id",
            "delegatee_id"
          ],
          "references": {
            "table": "users",
            "columns": [
              "iq_tenant_id",
              "id"
            ]
          }
        },
        {
          "columns": [
            "iq_tenant_id",
            "delegated_role_id"
          ],
          "references": {
            "table": "roles",
            "columns": [
              "iq_tenant_id",
              "id"
            ]
          }
        },
        {
          "columns": [
            "delegated_capability_id"
          ],
          "references": {
            "table": "capabilities",
            "columns": [
              "id"
            ]
          },
          "note": "FK to reference table"
        }
      ],
      "indexes": [
        {
          "columns": [
            "iq_tenant_id",
            "delegatee_id",
            "status"
          ],
          "name": "idx_delegations_delegatee_active",
          "note": "Active delegations for a user: WHERE status = 'active'"
        },
        {
          "columns": [
            "iq_tenant_id",
            "delegator_id"
          ],
          "name": "idx_delegations_delegator"
        }
      ],
      "checks": [
        {
          "expression": "(delegation_type = 'role' AND delegated_role_id IS NOT NULL AND delegated_capability_id IS NULL) OR (delegation_type = 'capability' AND delegated_capability_id IS NOT NULL AND delegated_role_id IS NULL)",
          "name": "chk_delegation_target"
        },
        {
          "expression": "effective_to > effective_from",
          "name": "chk_delegation_dates"
        },
        {
          "expression": "delegator_id != delegatee_id",
          "name": "chk_delegation_self"
        }
      ]
    },
    "user_clearances": {
      "description": "Sensitivity clearances for accessing restricted record types (psychiatric, VIP, HIV, substance abuse).",
      "distribution": "distributed",
      "columns": {
        "iq_tenant_id": {
          "type": "UUID",
          "nullable": false
        },
        "id": {
          "type": "UUID",
          "nullable": false,
          "default": "gen_random_uuid()"
        },
        "user_id": {
          "type": "UUID",
          "nullable": false
        },
        "clearance_type": {
          "type": "TEXT",
          "nullable": false,
          "description": "Category: 'psychiatric', 'vip', 'hiv', 'substance_abuse', 'reproductive'"
        },
        "clearance_level": {
          "type": "TEXT",
          "nullable": false,
          "check": "clearance_level IN ('view', 'view_and_edit')"
        },
        "granted_by": {
          "type": "UUID",
          "nullable": false
        },
        "granted_at": {
          "type": "TIMESTAMPTZ",
          "nullable": false,
          "default": "now()"
        },
        "expires_at": {
          "type": "TIMESTAMPTZ",
          "nullable": true,
          "description": "Null = does not expire (revocation still possible)"
        },
        "revoked_at": {
          "type": "TIMESTAMPTZ",
          "nullable": true
        },
        "revoked_by": {
          "type": "UUID",
          "nullable": true
        },
        "created_at": {
          "type": "TIMESTAMPTZ",
          "nullable": false,
          "default": "now()"
        },
        "updated_at": {
          "type": "TIMESTAMPTZ",
          "nullable": false,
          "default": "now()"
        }
      },
      "primary_key": [
        "iq_tenant_id",
        "id"
      ],
      "unique_constraints": [
        {
          "columns": [
            "iq_tenant_id",
            "user_id",
            "clearance_type"
          ],
          "name": "uq_user_clearances",
          "where": "revoked_at IS NULL",
          "note": "One active clearance per type per user"
        }
      ],
      "foreign_keys": [
        {
          "columns": [
            "iq_tenant_id",
            "user_id"
          ],
          "references": {
            "table": "users",
            "columns": [
              "iq_tenant_id",
              "id"
            ]
          }
        }
      ],
      "indexes": [
        {
          "columns": [
            "iq_tenant_id",
            "user_id",
            "revoked_at"
          ],
          "name": "idx_clearances_user_active"
        }
      ]
    },
    "department_projection": {
      "description": "Read projection of departments from Master Data module. Synced via master-data.department.* events. Rebuildable.",
      "distribution": "distributed",
      "columns": {
        "iq_tenant_id": {
          "type": "UUID",
          "nullable": false
        },
        "department_id": {
          "type": "UUID",
          "nullable": false
        },
        "name": {
          "type": "TEXT",
          "nullable": false
        },
        "code": {
          "type": "TEXT",
          "nullable": true
        },
        "parent_department_id": {
          "type": "UUID",
          "nullable": true,
          "description": "For department hierarchy. References self."
        },
        "is_active": {
          "type": "BOOLEAN",
          "nullable": false,
          "default": true
        },
        "last_synced": {
          "type": "TIMESTAMPTZ",
          "nullable": false,
          "default": "now()"
        }
      },
      "primary_key": [
        "iq_tenant_id",
        "department_id"
      ],
      "indexes": [
        {
          "columns": [
            "iq_tenant_id",
            "parent_department_id"
          ],
          "name": "idx_dept_projection_parent"
        }
      ]
    },
    "idp_configurations": {
      "description": "Federation setup \u2014 external Identity Providers configured per tenant (Entra ID, Okta, Keycloak, etc.).",
      "distribution": "distributed",
      "columns": {
        "iq_tenant_id": {
          "type": "UUID",
          "nullable": false
        },
        "id": {
          "type": "UUID",
          "nullable": false,
          "default": "gen_random_uuid()"
        },
        "provider_type": {
          "type": "TEXT",
          "nullable": false,
          "check": "provider_type IN ('oidc', 'saml')"
        },
        "provider_name": {
          "type": "TEXT",
          "nullable": false,
          "description": "e.g. 'entra_id', 'okta', 'keycloak', 'custom'"
        },
        "display_name": {
          "type": "TEXT",
          "nullable": false
        },
        "client_id": {
          "type": "TEXT",
          "nullable": false
        },
        "issuer_url": {
          "type": "TEXT",
          "nullable": false
        },
        "metadata_url": {
          "type": "TEXT",
          "nullable": true
        },
        "is_active": {
          "type": "BOOLEAN",
          "nullable": false,
          "default": true
        },
        "auto_provision": {
          "type": "BOOLEAN",
          "nullable": false,
          "default": true,
          "description": "Enable JIT provisioning on first federated login"
        },
        "default_role_ids": {
          "type": "JSONB",
          "nullable": true,
          "description": "Role IDs to assign on JIT provision. Justified JSONB: varies per IdP config, not queried."
        },
        "attribute_mapping": {
          "type": "JSONB",
          "nullable": true,
          "description": "Maps IdP claims to platform attributes. Justified JSONB: schema varies by IdP."
        },
        "created_at": {
          "type": "TIMESTAMPTZ",
          "nullable": false,
          "default": "now()"
