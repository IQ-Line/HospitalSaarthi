    "permission_change_audit": {
      "description": "Audit trail for all authorization data changes. Append-only.",
      "distribution": "distributed",
      "columns": {
        "iq_tenant_id": {
          "type": "UUID",
          "nullable": false
        },
        "id": {
          "type": "UUID",
          "nullable": false,
          "default": "gen_random_uuid()"
        },
        "entity_type": {
          "type": "TEXT",
          "nullable": false,
          "description": "What was changed: 'role_assignment', 'role_capability', 'delegation', 'clearance', 'user_status', 'role'. Department transfers are recorded under 'user_status' with department context in old_value/new_value JSONB."
        },
        "entity_id": {
          "type": "UUID",
          "nullable": false
        },
        "action": {
          "type": "TEXT",
          "nullable": false,
          "check": "action IN ('created', 'updated', 'revoked', 'expired')"
        },
        "changed_by": {
          "type": "UUID",
          "nullable": false
        },
        "changed_at": {
          "type": "TIMESTAMPTZ",
          "nullable": false,
          "default": "now()"
        },
        "old_value": {
          "type": "JSONB",
          "nullable": true,
          "description": "Previous state. Justified JSONB: polymorphic shape varies by entity_type."
        },
        "new_value": {
          "type": "JSONB",
          "nullable": true,
          "description": "New state. Justified JSONB: polymorphic shape varies by entity_type."
        },
        "reason": {
          "type": "TEXT",
          "nullable": true
        }
      },
      "primary_key": [
        "iq_tenant_id",
        "id"
      ],
      "indexes": [
        {
          "columns": [
            "iq_tenant_id",
            "entity_type",
            "entity_id"
          ],
          "name": "idx_audit_entity"
        },
        {
          "columns": [
            "iq_tenant_id",
            "changed_at"
          ],
          "name": "idx_audit_changed_at"
        },
        {
          "columns": [
            "iq_tenant_id",
            "changed_by"
          ],
          "name": "idx_audit_changed_by"
        }
      ]
    },
