{
  "name": "ts-sdk-tenant",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "packages/ts-sdk-tenant/src",
  "projectType": "library",
  "tags": ["scope:sdk", "type:lib"],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc -p tsconfig.json",
        "cwd": "packages/ts-sdk-tenant"
      },
      "outputs": ["{projectRoot}/dist"]
    },
    "lint": {
      "executor": "@nx/eslint:lint"
    },
    "test": {
      "executor": "@nx/js:node",
      "options": {
        "args": ["--run"],
        "runtimeExecutable": "vitest"
      }
    }
  }
}
