{
  "name": "ts-sdk-tenant",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "packages/ts-sdk-tenant/src",
  "projectType": "library",
  "tags": ["scope:sdk", "type:lib"],
  "targets": {
    "build": {
      "executor": "@nx/js:tsc",
      "outputs": ["{options.outputPath}"],
      "options": {
        "outputPath": "dist/packages/ts-sdk-tenant",
        "tsConfig": "packages/ts-sdk-tenant/tsconfig.json",
        "main": "packages/ts-sdk-tenant/src/index.ts"
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint"
    },
    "test": {
      "executor": "@nx/js:node",
      "options": {
        "args": ["--run"],
        "runtimeExecutable": "vitest"
      }
    }
  }
}
