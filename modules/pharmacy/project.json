{
  "name": "pharmacy",
  "tags": ["type:module", "scope:pharmacy", "language:typescript"],
  "targets": {
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "vitest run",
        "cwd": "modules/pharmacy"
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint",
      "options": {
        "lintFilePatterns": ["modules/pharmacy/src/**/*.ts"]
      }
    },
    "db-generate": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm exec drizzle-kit generate",
        "cwd": "modules/pharmacy"
      }
    },
    "db-migrate": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsx scripts/apply-migration.ts",
        "cwd": "modules/pharmacy"
      }
    }
  }
}
