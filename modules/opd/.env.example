# Reference copy for OPD_* keys. Prefer the monorepo root `.env`
# (see repo `.env.example`); this file is optional for package-only overrides.
# DB URL: the shared root DATABASE_URL is used by default (single hims_dev DB,
# ADR-0013). OPD_DATABASE_URL is an OPTIONAL override (e.g. driver/role swap);
# when unset it falls back to DATABASE_URL.
# OPD_DATABASE_URL=postgresql+psycopg://hims:hims@localhost:5433/hims_dev
OPD_LOG_LEVEL=INFO
OPD_API_PREFIX=/api/v1/opd
OPD_CORS_ORIGINS=http://localhost:4200,http://localhost:5173
PHARMACY_URL=http://localhost:3004
# PHARMACY_INTERNAL_API_KEY=change-me-in-production
