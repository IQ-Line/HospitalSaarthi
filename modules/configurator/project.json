{
  "name": "configurator",
  "tags": ["type:module", "scope:configurator", "language:typescript"],
  "targets": {
    "build": {
      "executor": "@nx/js:tsc",
      "options": {
        "outputPath": "dist/modules/configurator",
        "main": "modules/configurator/src/index.ts",
        "tsConfig": "modules/configurator/tsconfig.json"
      }
    },
    "db:migrate": {
      "command": "tsx ../../tools/run-sql-migrations.mts --db-env CONFIGURATOR_DATABASE_URL ./../../infra/db/migrations/001_configurator_core_tables.sql ./../../infra/db/migrations/002_configurator_tenant_modules.sql ./../../infra/db/migrations/003_configurator_tenant_modules_standard_columns.sql ./../../infra/db/migrations/004_configurator_tenant_branch_columns.sql",
      "options": {
        "cwd": "modules/configurator"
      }
    },
    "db-migrate": {
      "command": "tsx ../../tools/run-sql-migrations.mts --db-env CONFIGURATOR_DATABASE_URL ./../../infra/db/migrations/001_configurator_core_tables.sql ./../../infra/db/migrations/002_configurator_tenant_modules.sql ./../../infra/db/migrations/003_configurator_tenant_modules_standard_columns.sql ./../../infra/db/migrations/004_configurator_tenant_branch_columns.sql",
      "options": {
        "cwd": "modules/configurator"
      }
    },
    "test": {
      "executor": "@nx/js:node",
      "options": {
        "command": "vitest run",
        "cwd": "modules/configurator"
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint",
      "options": {
        "lintFilePatterns": ["modules/configurator/src/**/*.ts"]
      }
    }
  }
}
