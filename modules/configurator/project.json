{
  "name": "configurator",
  "tags": ["type:module", "scope:configurator", "language:typescript"],
  "targets": {
    "db-generate": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm exec drizzle-kit generate",
        "cwd": "modules/configurator"
      }
    },
    "db-migrate": {
      "command": "tsx scripts/apply-migration.ts",
      "options": {
        "cwd": "modules/configurator"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "vitest run",
        "cwd": "modules/configurator"
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint",
      "options": {
        "lintFilePatterns": ["modules/configurator/src/**/*.ts"]
      }
    }
  }
}
