{
  "name": "empi",
  "tags": ["type:module", "scope:empi", "language:typescript"],
  "targets": {
    "build": {
      "executor": "@nx/js:tsc",
      "options": {
        "outputPath": "dist/modules/empi",
        "main": "modules/empi/src/index.ts",
        "tsConfig": "modules/empi/tsconfig.json"
      }
    },
    "test": {
      "executor": "@nx/js:node",
      "options": {
        "command": "vitest run",
        "cwd": "modules/empi"
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint",
      "options": {
        "lintFilePatterns": ["modules/empi/src/**/*.ts"]
      }
    },
    "db-generate": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "modules/empi",
        "command": "drizzle-kit generate --config=drizzle.config.ts"
      }
    },
    "db-migrate": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "modules/empi",
        "command": "node ./scripts/run-migrate.mjs"
      }
    }
  }
}
