{
  "name": "user-management",
  "tags": ["type:module", "scope:platform"],
  "targets": {
    "db:migrate": {
      "command": "tsx scripts/apply-migration.ts",
      "options": {
        "cwd": "modules/user-management"
      }
    },
    "db-migrate": {
      "command": "tsx scripts/apply-migration.ts",
      "options": {
        "cwd": "modules/user-management"
      }
    },
    "seed-platform": {
      "command": "tsx scripts/seed-platform-bootstrap.ts",
      "options": {
        "cwd": "modules/user-management"
      }
    },
    "test": {
      "dependsOn": ["^build"],
      "command": "pnpm exec vitest run",
      "options": {
        "cwd": "modules/user-management"
      }
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "command": "tsc -p tsconfig.json --noEmit",
      "options": {
        "cwd": "modules/user-management"
      }
    },
    "lint": {
      "command": "eslint src/",
      "options": {
        "cwd": "modules/user-management"
      }
    }
  }
}
