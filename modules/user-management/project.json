{
  "name": "user-management",
  "tags": ["type:module", "scope:platform"],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc -p tsconfig.lib.json",
        "cwd": "modules/user-management"
      },
      "outputs": ["{projectRoot}/dist"]
    },
    "db:migrate": {
      "command": "tsx ../../tools/run-sql-migrations.mts --db-env USER_MGMT_DATABASE_URL --fallback-env DATABASE_URL ./migrations/0000_user_management_schema.sql ./migrations/0001_better_auth_auth_schema.sql ./migrations/0002_capability_catalog_seed.sql",
      "options": {
        "cwd": "modules/user-management"
      }
    },
    "db-migrate": {
      "command": "tsx ../../tools/run-sql-migrations.mts --db-env USER_MGMT_DATABASE_URL --fallback-env DATABASE_URL ./migrations/0000_user_management_schema.sql ./migrations/0001_better_auth_auth_schema.sql ./migrations/0002_capability_catalog_seed.sql",
      "options": {
        "cwd": "modules/user-management"
      }
    },
    "test": {
      "dependsOn": ["^build"],
      "command": "pnpm exec vitest run",
      "options": {
        "cwd": "modules/user-management"
      }
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "command": "tsc -p tsconfig.json --noEmit",
      "options": {
        "cwd": "modules/user-management"
      }
    },
    "lint": {
      "command": "eslint src/",
      "options": {
        "cwd": "modules/user-management"
      }
    }
  }
}
