# Reference copy for MASTER_DATA_* keys. Prefer the monorepo root `.env`
# (see repo `.env.example`); this file is optional for package-only overrides.
MASTER_DATA_DATABASE_URL=postgresql+psycopg://hims:hims@localhost:5433/hims_dev
MASTER_DATA_LOG_LEVEL=INFO
MASTER_DATA_API_PREFIX=/api/v1/master-data
MASTER_DATA_CORS_ORIGINS=http://localhost:4200,http://localhost:5173
# Platform tenant UUID for global Visitpad (and similar) catalog rows.
# For staging/production, set MASTER_DATA_APP_ENV and replace this with a real tenant UUID;

# AuthZ configuration (Cerbos + JWT)
MASTER_DATA_AUTH_BYPASS=false
MASTER_DATA_DEV_BEARER_TOKEN=dev-token
MASTER_DATA_AUTHZ_ENABLED=true
MASTER_DATA_JWT_SECRET=local-dev-jwt-secret-change-in-production-min-32-chars!!
MASTER_DATA_USER_MANAGEMENT_URL=http://localhost:3005
MASTER_DATA_CERBOS_URL=localhost:3593
