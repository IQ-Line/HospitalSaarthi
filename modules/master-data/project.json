{
  "name": "master-data",
  "tags": ["type:module", "scope:master-data", "language:python"],
  "namedInputs": {
    "default": ["{projectRoot}/**/*"],
    "production": [
      "default",
      "!{projectRoot}/tests/**/*",
      "!{projectRoot}/.env*",
      "!{projectRoot}/SETUP.md",
      "!{projectRoot}/README.md"
    ]
  },
  "targets": {
    "setup": {
      "command": "py -m pip install -r requirements.txt",
      "options": {
        "cwd": "modules/master-data"
      },
      "inputs": ["default", "{projectRoot}/requirements.txt"],
      "cache": true
    },
    "serve": {
      "command": "py scripts/dev_serve.py",
      "options": {
        "cwd": "modules/master-data",
        "envFile": "{workspaceRoot}/.env"
      },
      "dependsOn": ["setup"]
    },
    "lint": {
      "command": "uv run ruff check .",
      "options": {
        "cwd": "modules/master-data"
      },
      "dependsOn": ["setup"],
      "inputs": ["default", "{projectRoot}/pyproject.toml"],
      "cache": true
    },
    "test": {
      "command": "uv run pytest",
      "options": {
        "cwd": "modules/master-data"
      },
      "dependsOn": ["setup"],
      "inputs": ["default"],
      "cache": true
    },
    "migrate": {
      "command": "py -m alembic upgrade heads",
      "options": {
        "cwd": "modules/master-data",
        "envFile": "{workspaceRoot}/.env"
      },
      "dependsOn": ["setup"]
    },
    "db-migrate": {
      "command": "py -m alembic upgrade heads",
      "options": {
        "cwd": "modules/master-data",
        "envFile": "{workspaceRoot}/.env"
      },
      "dependsOn": ["setup"]
    }
  }
}
