{
  "name": "master-data",
  "projectType": "application",
  "tags": ["type:service", "scope:master-data", "language:python", "deploy:aks"],
  "namedInputs": {
    "default": ["{projectRoot}/**/*"],
    "production": [
      "default",
      "!{projectRoot}/tests/**/*",
      "!{projectRoot}/.env*",
      "!{projectRoot}/SETUP.md",
      "!{projectRoot}/README.md"
    ]
  },
  "targets": {
    "setup": {
      "command": "py scripts/ensure_deps.py",
      "options": {
        "cwd": "modules/master-data"
      },
      "inputs": ["default", "{projectRoot}/pyproject.toml", "{projectRoot}/uv.lock"],
      "cache": true,
      "outputs": ["{projectRoot}/.venv"]
    },
    "serve": {
      "command": "py scripts/run_uv.py uvicorn app.main:app --host 0.0.0.0 --port 8010 --reload",
      "options": {
        "cwd": "modules/master-data",
        "envFile": "{workspaceRoot}/.env"
      },
      "dependsOn": ["setup"]
    },
    "lint": {
      "command": "py scripts/run_uv.py ruff check .",
      "options": {
        "cwd": "modules/master-data"
      },
      "dependsOn": ["setup"],
      "inputs": ["default", "{projectRoot}/pyproject.toml"],
      "cache": true
    },
    "test": {
      "command": "py scripts/run_uv.py pytest",
      "options": {
        "cwd": "modules/master-data"
      },
      "dependsOn": ["setup"],
      "inputs": ["default"],
      "cache": true
    },
    "migrate": {
      "command": "py scripts/run_uv.py alembic upgrade heads",
      "options": {
        "cwd": "modules/master-data",
        "envFile": "{workspaceRoot}/.env"
      },
      "dependsOn": ["setup"]
    },
    "db-migrate": {
      "command": "py scripts/run_uv.py alembic upgrade heads",
      "options": {
        "cwd": "modules/master-data",
        "envFile": "{workspaceRoot}/.env"
      },
      "dependsOn": ["setup"]
    }
  }
}
