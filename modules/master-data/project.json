{
  "name": "master-data",
  "projectType": "library",
  "tags": ["type:module", "scope:master-data", "language:python"],
  "namedInputs": {
    "default": ["{projectRoot}/**/*"],
    "production": [
      "default",
      "!{projectRoot}/tests/**/*",
      "!{projectRoot}/.env*",
      "!{projectRoot}/SETUP.md",
      "!{projectRoot}/README.md"
    ]
  },
  "targets": {
    "setup": {
      "command": "uv sync",
      "options": {
        "cwd": "modules/master-data"
      },
      "inputs": ["default", "{projectRoot}/pyproject.toml", "{projectRoot}/uv.lock"],
      "cache": true,
      "outputs": ["{projectRoot}/.venv"]
    },
    "lint": {
      "command": "uv run ruff check .",
      "options": {
        "cwd": "modules/master-data"
      },
      "dependsOn": ["setup"],
      "inputs": ["default", "{projectRoot}/pyproject.toml"],
      "cache": true
    },
    "test": {
      "command": "uv run pytest",
      "options": {
        "cwd": "modules/master-data"
      },
      "dependsOn": ["setup"],
      "inputs": ["default"],
      "cache": true
    },
    "migrate": {
      "command": "bash scripts/run-migrations.sh",
      "options": {
        "cwd": "modules/master-data"
      },
      "dependsOn": ["setup"]
    },
    "db-migrate": {
      "command": "bash scripts/run-migrations.sh",
      "options": {
        "cwd": "modules/master-data"
      },
      "dependsOn": ["setup"]
    }
  }
}
