{
  "name": "frontdesk",
  "tags": ["type:module", "scope:frontdesk", "language:typescript"],
  "targets": {
    "build": {
      "executor": "@nx/js:tsc",
      "options": {
        "outputPath": "dist/modules/frontdesk",
        "main": "modules/frontdesk/src/index.ts",
        "tsConfig": "modules/frontdesk/tsconfig.json"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "vitest run",
        "cwd": "modules/frontdesk"
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint",
      "options": {
        "lintFilePatterns": ["modules/frontdesk/src/**/*.ts"]
      }
    }
  }
}
